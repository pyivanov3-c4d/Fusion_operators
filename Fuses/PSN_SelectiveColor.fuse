-- PSN_SelectiveColor 1.1
-- Original Lua implementation of the normalized equations published by Clement Boesch:
-- https://blog.pkh.me/p/22-understanding-selective-coloring-in-adobe-photoshop.html
-- No Photoshop or FFmpeg source code is included in this implementation.
FuRegisterClass("PavelSelectiveColor", CT_Tool, {
    REGS_Name = "PSN_SelectiveColor",
    REGS_Category = "PSN\\Color",
    REGS_OpIconString = "SlC",
    REGS_OpDescription = "Photoshop-style Selective Color: nine color families and Relative/Absolute CMYK adjustments",
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

local families = {"Reds", "Yellows", "Greens", "Cyans", "Blues", "Magentas", "Whites", "Neutrals", "Blacks"}
local inks = {"Cyan", "Magenta", "Yellow", "Black"}
local inkLabels = {"Red/Cyan", "Green/Magenta", "Blue/Yellow", "White/Black"}
local familyLabels = {"R", "Y", "G", "C", "B", "M", "W", "N", "K"}

function Create()
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image", LINK_Main = 1, INP_AcceptsDoD = false,
    })
    OutImage = self:AddOutput("Output", "Output", {LINKID_DataType = "Image", LINK_Main = 1})
    local menu = {
        LINKID_DataType = "Number", INPID_InputControl = "MultiButtonControl",
        INP_Default = 0, INP_Integer = true, INP_External = false,
        INP_DoNotifyChanged = true, INP_InitialNotify = true, INP_Passive = true,
        MBTNC_StretchToFit = true, MBTNC_ShowName = false,
        MBTNC_ButtonHeight = 26,
    }
    for i, name in ipairs(families) do
        table.insert(menu, {MBTNC_AddButton = familyLabels[i], MBTNCD_ButtonWidth = 1/9,
            MBTNCS_ToolTip = name, MBTNC_ShowLabel = true})
    end
    InColors = self:AddInput("Colors", "Colors", menu)
    Adjustments = {}
    for i, family in ipairs(families) do
        Adjustments[i] = {}
        for j, ink in ipairs(inks) do
            Adjustments[i][j] = self:AddInput(inkLabels[j], family .. ink, {
                LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
                INP_Default = 0, INP_MinScale = -100, INP_MaxScale = 100,
                INP_MinAllowed = -100, INP_MaxAllowed = 100,
                IC_Visible = i == 1,
                INPS_StatusText = family .. ": " .. inkLabels[j] .. ". Positive adds " .. ink .. "; negative adds its opposite. Existing Photoshop sign convention is preserved.",
            })
        end
    end
    InMethod = self:AddInput("Method", "Method", {
        LINKID_DataType = "Number", INPID_InputControl = "MultiButtonControl",
        INP_Default = 0, INP_Integer = true, MBTNC_StretchToFit = true,
        {MBTNC_AddButton = "Relative", MBTNCD_ButtonWidth = 0.5},
        {MBTNC_AddButton = "Absolute", MBTNCD_ButtonWidth = 0.5},
    })
    InPreview = self:AddInput("Preview", "Preview", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
    })
    self:BeginControlNest("Fusion Options", "FusionOptions", false, {})
    InSpace = self:AddInput("Input encoding", "InputEncoding", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0,
        {CCS_AddString = "RGB as supplied (Photoshop-style)"},
        {CCS_AddString = "Linear sRGB / Rec.709 primaries"},
        INPS_StatusText = "Use RGB as supplied for gamma-encoded images. Linear option converts linear sRGB to sRGB for the adjustment and back; it is not an ACES transform.",
    })
    InAlpha = self:AddInput("Pre-Divide / Post-Multiply", "PreDivide", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
        INPS_StatusText = "Unpremultiply before adjusting color, then restore the original alpha. Disable for straight-alpha inputs.",
    })
    self:EndControlNest()
end

function NotifyChanged(inp, param, time)
    if inp == InColors and Adjustments then
        local selected = math.floor(param.Value + 0.5) + 1
        for i = 1, 9 do
            for j = 1, 4 do Adjustments[i][j]:SetAttrs({IC_Visible = i == selected}) end
        end
    end
end

-- This callback has an isolated per-thread environment supplied by MultiProcessPixels.
local processPixel = function(x, y, p)
    local alpha = p.A
    if unpremultiply and alpha <= 0 then return p end
    local factor = unpremultiply and alpha or 1
    local r, g, b = p.R / factor, p.G / factor, p.B / factor
    if linear then
        r = r <= 0.0031308 and 12.92*r or 1.055*r^(1/2.4)-0.055
        g = g <= 0.0031308 and 12.92*g or 1.055*g^(1/2.4)-0.055
        b = b <= 0.0031308 and 12.92*b or 1.055*b^(1/2.4)-0.055
    end
    -- Selective Color is an SDR adjustment. Preserve out-of-range residuals rather
    -- than clipping untouched HDR/negative values in a floating-point compositor.
    local cr, cg, cb = math.min(1, math.max(0,r)), math.min(1, math.max(0,g)), math.min(1, math.max(0,b))
    local lo, hi = math.min(cr,cg,cb), math.max(cr,cg,cb)
    local mid = cr + cg + cb - lo - hi
    local dr, dg, db = 0, 0, 0
    for i = 1, count do
        local a = settings[i]
        local family, weight = a[1], 0
        if family == 1 and cr == hi then weight = hi-mid
        elseif family == 2 and cb == lo then weight = mid-lo
        elseif family == 3 and cg == hi then weight = hi-mid
        elseif family == 4 and cr == lo then weight = mid-lo
        elseif family == 5 and cb == hi then weight = hi-mid
        elseif family == 6 and cg == lo then weight = mid-lo
        elseif family == 7 then weight = math.max(0, 2*lo-1)
        elseif family == 8 then weight = 1-math.abs(hi-0.5)-math.abs(lo-0.5)
        elseif family == 9 then weight = math.max(0, 1-2*hi)
        end
        if weight > 0 then
            local k = a[5]
            local rr, gg, bb = -a[2]*(1+k)-k, -a[3]*(1+k)-k, -a[4]*(1+k)-k
            if relative then rr, gg, bb = rr*(1-cr), gg*(1-cg), bb*(1-cb) end
            dr = dr + weight*math.min(1-cr, math.max(-cr,rr))
            dg = dg + weight*math.min(1-cg, math.max(-cg,gg))
            db = db + weight*math.min(1-cb, math.max(-cb,bb))
        end
    end
    r = r-cr + math.min(1, math.max(0,cr+dr))
    g = g-cg + math.min(1, math.max(0,cg+dg))
    b = b-cb + math.min(1, math.max(0,cb+db))
    if linear then
        r = r <= 0.04045 and r/12.92 or ((r+0.055)/1.055)^2.4
        g = g <= 0.04045 and g/12.92 or ((g+0.055)/1.055)^2.4
        b = b <= 0.04045 and b/12.92 or ((b+0.055)/1.055)^2.4
    end
    p.R, p.G, p.B = r*factor, g*factor, b*factor
    return p
end

function Process(req)
    local src = InImage:GetValue(req)
    if not src then return end
    local settings = {}
    for i = 1, 9 do
        local a = {i}
        local active = false
        for j = 1, 4 do
            a[j+1] = Adjustments[i][j]:GetValue(req).Value / 100
            if a[j+1] ~= 0 then active = true end
        end
        if active then table.insert(settings, a) end
    end
    if #settings == 0 or InPreview:GetValue(req).Value < 0.5 then OutImage:Set(req, src); return end
    src:DownloadGPUMem(req)
    local dst = Image({IMG_Like = src})
    dst:MultiProcessPixels(nil, {
        settings = settings, count = #settings,
        relative = InMethod:GetValue(req).Value < 0.5,
        linear = InSpace:GetValue(req).Value > 0.5,
        unpremultiply = InAlpha:GetValue(req).Value > 0.5,
    }, 0, 0, src.Width, src.Height, src, processPixel)
    OutImage:Set(req, dst)
end



