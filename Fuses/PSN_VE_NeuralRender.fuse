	})
	self:EndControlNest()

	-- ---------------------------------------------------------------- Engine
	self:BeginControlNest("Engine", "EngineNest", true, {})
	InEngine = self:AddInput("VE_CLI.exe", "EnginePath", {
		LINKID_DataType = "Text",
		INPID_InputControl = "TextEditControl",
		INPS_DefaultText = [[C:\__Work\_DeepSeek\Design\dlss5-ve-release\app\VE_CLI.exe]],
		TEC_Lines = 1,
		ICS_ControlPage = "Engine",
	})
	InGPU = self:AddInput("GPU", "GPU", {
		LINKID_DataType = "Text",
		INPID_InputControl = "TextEditControl",
