	self:EndControlNest()
end

-- ---------------------------------------------------------------- state files

local function nodeKey(self)
	local name
	local ok1 = pcall(function() name = self.Name end)
	if not ok1 or not name then
		local ok2, attrs = pcall(function() return self:GetAttrs() end)
		if ok2 and attrs then name = attrs.TOOLS_Name end
	end
	return safeName(name)
end

local ADDED = false
local READY = false

function OnAddToFlow()
	ADDED = true
end

function NotifyChanged(inp, param, time)
	local sInp = tostring(inp)
	local isCheck = (sInp == tostring(InCheckUpdate))

	if isCheck then
		if not READY then return end
		pcall(function()
			if not UPD then return end
			local src = InUpdateSource:GetValue(0).Value
			UPD.install(src, UPD_DIR, false)
		end)
		return
	end
end

-- ---------------------------------------------------------------- process

local function signature(self, req, w, h)
	local parts = {
		w, h,
		math.floor(InAlgo:GetValue(req).Value + 0.5),
		math.floor(InModel:GetValue(req).Value + 0.5),
		math.floor(InScale:GetValue(req).Value + 0.5),
		math.floor(InDLSSMode:GetValue(req).Value + 0.5),
		math.floor(InStyle:GetValue(req).Value + 0.5),
		InIntensity:GetValue(req).Value,
		InPasses:GetValue(req).Value,
		InTone:GetValue(req).Value,
		InStructure:GetValue(req).Value,
		InSkin:GetValue(req).Value,
		InAutoMask:GetValue(req).Value,
		InSharpen:GetValue(req).Value,
		InSharpenAmount:GetValue(req).Value,
		InGrain:GetValue(req).Value,
		InGrainAmount:GetValue(req).Value,
		InSharpenMethod:GetValue(req).Value,
		InGrainSize:GetValue(req).Value,
		InGrainResponse:GetValue(req).Value,
		InReShade:GetValue(req).Value,
		InReShadePreset:GetValue(req).Value,
		InReShadeMix:GetValue(req).Value,
		InReShadeDepth:GetValue(req).Value,
		InColour:GetValue(req).Value,
		InLutPath:GetValue(req).Value,
		InLutSel:GetValue(req).Value,
		InLutFolder:GetValue(req).Value,
		InLutMix:GetValue(req).Value,
		InLutExposure:GetValue(req).Value,
		InLutContrast:GetValue(req).Value,
		InLutSaturation:GetValue(req).Value,
		InLutTemperature:GetValue(req).Value,
		InVsrQuality:GetValue(req).Value,
		InBitDepth:GetValue(req).Value,
		InSRGB:GetValue(req).Value,
		InEngine:GetValue(req).Value,
	}
	local s = {}
	for i = 1, #parts do s[i] = tostring(parts[i]) end
	return hash(table.concat(s, "|"))
end

local function buildCommand(engine, algo, model, scale, dlssMode, gpu, presetPath, inTif, outTif, bitDepth)
	local cmd
	if algo == 0 then
		cmd = string.format('"%s" render "%s" --preset "%s" -o "%s" --json --quiet',
			engine, inTif, presetPath, outTif)
	elseif algo == 1 or algo == 2 then
		local eng = (algo == 1) and model or "rtx"
		cmd = string.format('"%s" upscale "%s" --engine %s --scale %d --preset "%s" --format tiff --bit-depth %d -o "%s" --json --quiet',
			engine, inTif, eng, scale, presetPath, bitDepth, outTif)
	elseif algo == 3 then
		cmd = string.format('"%s" upscale "%s" --engine dlss --mode %s --preset "%s" --format tiff --bit-depth %d -o "%s" --json --quiet',
			engine, inTif, dlssMode, presetPath, bitDepth, outTif)
	else
		cmd = string.format('"%s" reconstruct "%s" --preset "%s" --format tiff --bit-depth %d -o "%s" --json --quiet',
			engine, inTif, presetPath, bitDepth, outTif)
	end
	if gpu and gpu ~= "" and gpu ~= "auto" then
		cmd = cmd:gsub(" --json", ' --gpu "' .. gpu .. '" --json', 1)
	end
	return cmd
end

function Process(req)
	local src = InImage:GetValue(req)
	if not src then OutImage:Set(req, nil) return end

	local ok, err = pcall(function()
		local engine = InEngine:GetValue(req).Value
		local cacheDir = InCacheDir:GetValue(req).Value
		if not engine or engine == "" or not cacheDir or cacheDir == "" then
			OutImage:Set(req, src)
			return
		end
		ensureDir(cacheDir)

		local srgbOn = InSRGB:GetValue(req).Value > 0.5
		local frameName = string.format("f%04d.tif", math.floor((req.Time or 1) + 0.5))
		local key = nodeKey(self)

		-- collect pass for the bake script
		if InCollect:GetValue(req).Value > 0.5 then
			local inDir = cacheDir .. "\\bake\\in"
			ensureDir(inDir)
			writeTIFF16(src, inDir .. "\\" .. frameName, srgbOn)
			OutImage:Set(req, src)
			return
		end

		-- baked result for this frame
		local bakeDir = InBakeDir:GetValue(req).Value
		if bakeDir and bakeDir ~= "" then
			local baked = bakeDir .. "\\" .. frameName
			if not fileExists(baked) then
				local alt = bakeDir .. "\\" .. (string.gsub(frameName, "%.tif$", ".tiff"))
				if fileExists(alt) then baked = alt end
			end
			if fileExists(baked) then
				local bimg = readTIFF16(baked, src, srgbOn)
				if bimg then OutImage:Set(req, bimg) return end
			end
		end

		local w, h = src.Width, src.Height
		local sig = signature(self, req, w, h)

		local outDir = cacheDir .. "\\" .. sig
		local outPath = outDir .. "\\" .. frameName
		local outAlt = outDir .. "\\" .. (string.gsub(frameName, "%.tif$", ".tiff"))

		for _, candidate in ipairs({ outPath, outAlt }) do
			if fileExists(candidate) then
				local img = readTIFF16(candidate, src, srgbOn)
				if img then OutImage:Set(req, img) return end
			end
		end

		if InBake:GetValue(req).Value > 0.5 then
			-- background bake: queue the frame, return the source, let the worker batch it
			ensureDir(outDir)
			ensureDir(outDir .. "\\in")
			local presetPath = cacheDir .. "\\preset_" .. sig .. ".json"
			writeAll(presetPath, buildPreset(req))

			local inFrame = outDir .. "\\in\\" .. frameName
			if not fileExists(inFrame) then
				local tmpFrame = inFrame .. ".tmp"
				writeTIFF16(src, tmpFrame, srgbOn)
				os.remove(inFrame)
				os.rename(tmpFrame, inFrame)
			end

			local lock = outDir .. "\\worker.lock"
			local running = false
			if fileExists(lock) then
				local stamp = tonumber((readAll(lock) or ""):match("%d+") or "")
				if stamp and (os.time() - stamp) < 120 then running = true end
			end
			if not running then
				writeAll(lock, tostring(os.time()))
				os.execute(string.format(
					'cmd /c start "" /b powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%s" -SigDir "%s" -Engine "%s" -Preset "%s" -Node "%s" -Refresh "%s"',
					UPD_DIR .. "\\PSN_VE_AutoBake.ps1", outDir, engine, presetPath, key, UPD_DIR .. "\\PSN_VE_Refresh.lua"))
			end

			OutImage:Set(req, src)
			return
		end

		-- ---- engine run
		ensureDir(outDir)
		local inTif = cacheDir .. "\\in_" .. sig .. ".tif"
		if not fileExists(inTif) then
			writeTIFF16(src, inTif, srgbOn)
		end

		local algo = math.floor(InAlgo:GetValue(req).Value + 0.5)
		local model = MODELS[math.max(1, math.min(#MODELS, math.floor(InModel:GetValue(req).Value + 0.5) + 1))]
		local scale = SCALES[math.max(1, math.min(#SCALES, math.floor(InScale:GetValue(req).Value + 0.5) + 1))]
		local dlssMode = DLSS_MODES[math.max(1, math.min(#DLSS_MODES, math.floor(InDLSSMode:GetValue(req).Value + 0.5) + 1))]

		local style = STYLES[math.max(1, math.min(3, math.floor(InStyle:GetValue(req).Value + 0.5) + 1))]

		local presetPath = cacheDir .. "\\preset_" .. sig .. ".json"
		writeAll(presetPath, buildPreset(req))

		local gpu = InGPU:GetValue(req).Value
		local bitDepth = (InBitDepth:GetValue(req).Value > 0.5) and 16 or 8
		local cmd = buildCommand(engine, algo, model, scale, dlssMode, gpu, presetPath, inTif, outPath, bitDepth)

		local batPath = cacheDir .. "\\run_" .. sig .. ".cmd"
		writeAll(batPath, "@echo off\r\n" .. cmd .. " 2>&1\r\n")

		local t0 = os.clock()
		local handle = io.popen('cmd /c "' .. batPath .. '"')
		local result = handle and handle:read("*a") or ""
		if handle then handle:close() end
		logTo(cacheDir, string.format("run %s/%.1fs : %s", sig, os.clock() - t0,
			(result:gsub("%s+", " "):sub(1, 300))))

		local img, msg = readTIFF16(outPath, src, srgbOn)
		if img then
			os.remove(inTif)
			OutImage:Set(req, img)
			READY = true
		else
			logTo(cacheDir, "output unreadable: " .. tostring(msg))
			OutImage:Set(req, src)
		end
	end)

	if not ok then
		local fb = (os.getenv("TEMP") or ".") .. "\\psn_ve_error.log"
		local f = io.open(fb, "a")
		if f then f:write(nowStr(), "  ", tostring(err), "\n"); f:close() end
		OutImage:Set(req, src)
	end
end
