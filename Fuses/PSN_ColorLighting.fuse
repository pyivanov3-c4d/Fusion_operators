-- PSN_ColorLighting 1.0
-- Photoshop 28 "Light" adjustment layer (Exposure, Contrast, Highlights, Shadows,
-- Whites, Blacks) for Fusion. The six sliders are reproduced from the measured
-- response of Photoshop 28.0.0's own Light layer: 36 single-slider renders of a
-- neutral ramp plus interaction renders, composed as one calibrated transfer curve.
-- Adobe publishes no SDK or algorithm for this adjustment; the curves below are
-- measurements, not disassembly. See PSN_ColorLighting.md.
FuRegisterClass("PSN_ColorLighting", CT_Tool, {
    REGS_Name = "PSN_ColorLighting",
    REGS_Category = "PSN\\Color - Lighting",
    REGS_OpIconString = "CL",
    REGS_OpDescription = "Photoshop Light adjustment layer: Exposure, Contrast, Highlights, Shadows, Whites, Blacks",
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

-- Measured Photoshop 28.0 "Light" adjustment layer response, neutral ramp,
-- 8-bit sRGB, 0..1 encoded. 17 knots from 0 to 255 in steps of 15.94.
-- Generated from 36 single-slider renders; see PSN_ColorLighting.md.
