    },
    blacks = {
        [-100] = {0.0000, 0.0000, 0.0000, 0.0000, 0.0196, 0.1020, 0.1922, 0.2745, 0.3569, 0.4314, 0.5177, 0.6078, 0.6941, 0.7765, 0.8549, 0.9294, 1.0000},
        [-50] = {0.0000, 0.0000, 0.0667, 0.1373, 0.2039, 0.2745, 0.3412, 0.4078, 0.4745, 0.5373, 0.6039, 0.6706, 0.7372, 0.8039, 0.8706, 0.9373, 1.0000},
        [0] = {0.0000, 0.0628, 0.1255, 0.1882, 0.2510, 0.3137, 0.3765, 0.4392, 0.5020, 0.5608, 0.6235, 0.6863, 0.7490, 0.8118, 0.8745, 0.9373, 1.0000},
        [50] = {0.0000, 0.0784, 0.1569, 0.2275, 0.2902, 0.3569, 0.4196, 0.4784, 0.5412, 0.5922, 0.6510, 0.7059, 0.7647, 0.8196, 0.8784, 0.9373, 1.0000},
        [100] = {0.0000, 0.1020, 0.1922, 0.2667, 0.3333, 0.3961, 0.4588, 0.5177, 0.5726, 0.6196, 0.6706, 0.7216, 0.7725, 0.8275, 0.8823, 0.9412, 1.0000},
