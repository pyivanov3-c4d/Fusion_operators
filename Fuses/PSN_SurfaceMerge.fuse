-- PSN_SurfaceMerge 1.0
-- Place a sticker tangentially on a picked point of a surface.
--
-- One job: the plane of the sticker is the tangent plane of the surface at the
-- picked point. The sticker's two axes run along the two orthogonal tangents of
-- that plane, so the placement is foreshortened exactly as the plane is, and the
-- two axes stay perpendicular in 3D. Blending, shadow and light belong to the
-- rest of the comp, not here.
--
-- The normal comes from a normal map (any value in R,G,B). Without one the plane
-- is parallel to the screen, which is the flat placement.
--
-- This is a projective cheat in screen space, not a 3D card: the anchor plane is
-- projected with a linear tangent frame, which is exact for the plane itself and
-- drifts only when the placement is large compared with the camera distance.

local LOGPATH = "C:\\__Work\\_DeepSeek\\Fusion\\_psn_surfacemerge.log"

local function logline(msg)
    pcall(function()
        local f = io.open(LOGPATH, "a")
        if f then
            f:write(os.date("%Y-%m-%d %H:%M:%S ") .. msg .. "\n")
            f:close()
        end
    end)
end

FuRegisterClass("PSN_SurfaceMerge", CT_Tool, {
    REGS_Name = "PSN_SurfaceMerge",
    REGS_Category = "PSN\\Merge",
    REGS_OpIconString = "SMrg",
    REGS_OpDescription = "Place a sticker tangentially on a surface: the sticker plane equals the tangent plane at the picked point",
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

function Create()
    InBackground = self:AddInput("Background", "Background", {
        LINKID_DataType = "Image", LINK_Main = 1, INP_AcceptsDoD = false,
        INPS_StatusText = "The scene the sticker is placed into.",
    })
    InForeground = self:AddInput("Sticker", "Foreground", {
        LINKID_DataType = "Image", LINK_Main = 2, INP_AcceptsDoD = false,
        INPS_StatusText = "The image being placed. Premultiplied alpha, as usual in Fusion.",
    })
    InNormal = self:AddInput("Normal", "NormalMap", {
        LINKID_DataType = "Image", LINK_Main = 3, INP_AcceptsDoD = false, INP_Required = false, INP_Optional = true,
        INPS_StatusText = "Normal map: R,G,B = x,y,z of the surface normal. Unconnected means a plane parallel to the screen. If a horizontal top face reads as facing down, enable Flip Normal Y.",
    })

    InPosition = self:AddInput("Position", "Position", {
        LINKID_DataType = "Point",
        INPID_InputControl = "OffsetControl",
        INPID_PreviewControl = "PointControl",
        INP_DefaultX = 0.5,
        INP_DefaultY = 0.5,
        INP_DoNotifyChanged = true,
        PC_Visible = true,
        INPS_StatusText = "The point where the sticker touches the surface. The plane orientation is read from the normal at this point.",
    })
    InSize = self:AddInput("Size", "Size", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0.3, INP_MinScale = 0.02, INP_MaxScale = 2,
        INP_MinAllowed = 0.001, INP_MaxAllowed = 8,
        INPS_StatusText = "Width of the sticker in the surface plane, as a fraction of the frame height.",
    })
    InAspect = self:AddInput("Aspect", "Aspect", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0.1, INP_MaxScale = 4,
        INP_MinAllowed = 0.01, INP_MaxAllowed = 20,
        INPS_StatusText = "Height of the sticker relative to Size, measured in the surface plane before projection.",
    })
    InRotation = self:AddInput("Rotation", "Rotation", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0, INP_MinScale = -180, INP_MaxScale = 180,
        INP_MinAllowed = -3600, INP_MaxAllowed = 3600,
        INPS_StatusText = "Spin of the sticker inside the surface plane, in degrees.",
    })
    InEdge = self:AddInput("Edge Softness", "EdgeSoftness", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0.03, INP_MinScale = 0, INP_MaxScale = 0.5,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Softness of the sticker's outer edge, as a fraction of its half size. The sticker's own alpha is still respected.",
    })
    InFlip = self:AddInput("Flip Normal Y", "NormalFlipY", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 0,
        INPS_StatusText = "Inverts the green channel. Renderers disagree: flip when a horizontal top face reads as facing down.",
    })

    self:BeginControlNest("Merge", "MergeNest", true, {})
    InBlend = self:AddInput("Blend", "BlendMode", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0,
        { CCS_AddString = "Normal" },
        { CCS_AddString = "Add" },
        { CCS_AddString = "Subtract" },
        { CCS_AddString = "Multiply" },
        { CCS_AddString = "Screen" },
        { CCS_AddString = "Overlay" },
        { CCS_AddString = "Soft Light" },
        { CCS_AddString = "Hard Light" },
        { CCS_AddString = "Color Dodge" },
        { CCS_AddString = "Color Burn" },
        { CCS_AddString = "Darken" },
        { CCS_AddString = "Lighten" },
        { CCS_AddString = "Difference" },
        { CCS_AddString = "Exclusion" },
        { CCS_AddString = "Hue" },
        { CCS_AddString = "Saturation" },
        { CCS_AddString = "Color" },
        { CCS_AddString = "Luminosity" },
        { CCS_AddString = "Vivid Light" },
        { CCS_AddString = "Linear Light" },
        { CCS_AddString = "Pin Light" },
        { CCS_AddString = "Hard Mix" },
        { CCS_AddString = "Divide" },
        INPS_StatusText = "How the placement combines with the background. Lighting and shadow are not this operator's job: they come from the blend and the comp.",
    })
    InOpacity = self:AddInput("Opacity", "OpacityAmount", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Overall opacity of the placement, on top of the sticker's alpha.",
    })
    self:EndControlNest()

    InView = self:AddInput("View", "View", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0,
        { CCS_AddString = "Result" },
        { CCS_AddString = "Tangent frame" },
        INPS_StatusText = "Result is the placement. Tangent frame paints the sticker's axes, to check that the plane sits on the surface.",
    })

    OutImage = self:AddOutput("Output", "Output", { LINKID_DataType = "Image", LINK_Main = 1 })
end

local function clampf(v, a, b)
    if v < a then return a elseif v > b then return b end
    return v
end

local function smoothstep(a, b, x)
    if b <= a then return x < a and 0 or 1 end
    local t = clampf((x - a) / (b - a), 0, 1)
    return t * t * (3 - 2 * t)
end

-- Runs inside MultiProcessPixels: copies the background natively, so the Lua loop
-- below only has to touch the pixels the sticker can reach.
local function passthrough(x, y, p)
    return p
end

-- Blend modes, matching Fusion's Merge apply modes. Separable ones operate per
-- channel; Hue/Saturation/Color/Luminosity use the standard non-separable
-- construction (luminance 0.3/0.59/0.11, clip and set-lum as in Photoshop).
local function lum709(r, g, b)
    return 0.3 * r + 0.59 * g + 0.11 * b
end

local function clipColor(r, g, b)
    local l = lum709(r, g, b)
    local lo = math.min(r, g, b)
    local hi = math.max(r, g, b)
    if lo < 0 then
        local d = l - lo
        if d > 1e-9 then
            r, g, b = l + (r - l) * l / d, l + (g - l) * l / d, l + (b - l) * l / d
        end
    end
    if hi > 1 then
        local d = hi - l
        if d > 1e-9 then
            r, g, b = l + (r - l) * (1 - l) / d, l + (g - l) * (1 - l) / d, l + (b - l) * (1 - l) / d
        end
    end
    return r, g, b
end

local function setLum(r, g, b, l)
    local d = l - lum709(r, g, b)
    return clipColor(r + d, g + d, b + d)
end

local function satOf(r, g, b)
    return math.max(r, g, b) - math.min(r, g, b)
end

local function setSat(r, g, b, s)
    local lo = math.min(r, g, b)
    local hi = math.max(r, g, b)
    if hi - lo > 1e-9 then
        local k = s / (hi - lo)
        return (r - lo) * k, (g - lo) * k, (b - lo) * k
    end
    return 0, 0, 0
end

local function sep(mode, b, f)
    if mode == 2 then
        return b + f
    elseif mode == 3 then
        return b - f
    elseif mode == 4 then
        return b * f
    elseif mode == 5 then
        return 1 - (1 - b) * (1 - f)
    elseif mode == 6 then
        if b < 0.5 then return 2 * b * f end
        return 1 - 2 * (1 - b) * (1 - f)
    elseif mode == 7 then
        if f <= 0.5 then
            return b - (1 - 2 * f) * b * (1 - b)
        end
        local d = b <= 0.25 and ((16 * b - 12) * b + 4) * b or math.sqrt(math.max(0, b))
        return b + (2 * f - 1) * (d - b)
    elseif mode == 8 then
        if f < 0.5 then return 2 * f * b end
        return 1 - 2 * (1 - f) * (1 - b)
    elseif mode == 9 then
        if f >= 1 then return 1 end
        return math.min(1, b / (1 - f))
    elseif mode == 10 then
        if f <= 0 then return 0 end
        return 1 - math.min(1, (1 - b) / f)
    elseif mode == 11 then
        return math.min(b, f)
    elseif mode == 12 then
        return math.max(b, f)
    elseif mode == 13 then
        return math.abs(b - f)
    elseif mode == 14 then
        return b + f - 2 * b * f
    elseif mode == 19 then
        if f <= 0.5 then
            local ff = 2 * f
            if ff <= 0 then return 0 end
            return 1 - math.min(1, (1 - b) / ff)
        end
        local ff = 2 * f - 1
        if ff >= 1 then return 1 end
        return math.min(1, b / (1 - ff))
    elseif mode == 20 then
        return b + 2 * f - 1
    elseif mode == 21 then
        if f <= 0.5 then return math.min(b, 2 * f) end
        return math.max(b, 2 * f - 1)
    elseif mode == 22 then
        local v
        if f <= 0.5 then
            local ff = 2 * f
            v = ff <= 0 and 0 or 1 - math.min(1, (1 - b) / ff)
        else
            local ff = 2 * f - 1
            v = ff >= 1 and 1 or math.min(1, b / (1 - ff))
        end
        return v >= 0.5 and 1 or 0
    elseif mode == 23 then
        if f <= 1e-6 then return 1 end
        return math.min(1, b / f)
    end
    return f
end

local function blendRGB(mode, br, bgc, bb, fr, fg, fb)
    if mode >= 15 and mode <= 18 then
        -- W3C / Photoshop non-separable modes
        local lb = lum709(br, bgc, bb)
        if mode == 15 then
            local hr, hg, hb = setSat(fr, fg, fb, satOf(br, bgc, bb))
            return setLum(hr, hg, hb, lb)
        elseif mode == 16 then
            local sr, sg, sb = setSat(br, bgc, bb, satOf(fr, fg, fb))
            return setLum(sr, sg, sb, lb)
        elseif mode == 17 then
            return setLum(fr, fg, fb, lb)
        end
        return setLum(br, bgc, bb, lum709(fr, fg, fb))
    end
    return sep(mode, br, fr), sep(mode, bgc, fg), sep(mode, bb, fb)
end

local function doProcess(req)
    local bg = InBackground:GetValue(req)
    if not bg then return end
    bg:DownloadGPUMem(req)

    local fg = InForeground:GetValue(req)
    local nm = InNormal:GetValue(req)
    if fg then fg:DownloadGPUMem(req) end
    if nm then nm:DownloadGPUMem(req) end

    local w, h = bg.Width, bg.Height
    if w < 1 or h < 1 then return end
    local t0 = os.clock()

    local pos = InPosition:GetValue(req)
    local ax = clampf(pos.X, 0, 1)
    local ay = clampf(pos.Y, 0, 1)
    local size = math.max(0.001, InSize:GetValue(req).Value)
    local aspect = math.max(0.01, InAspect:GetValue(req).Value)
    local rot = math.rad(InRotation:GetValue(req).Value)
    local edgeSoft = math.max(1e-4, InEdge:GetValue(req).Value)
    local flipY = InFlip:GetValue(req).Value > 0.5
    local blendMode = math.floor(InBlend:GetValue(req).Value + 0.5)
    local opacity = clampf(InOpacity:GetValue(req).Value, 0, 1)
    local view = math.floor(InView:GetValue(req).Value + 0.5)

    -- surface normal at the picked point ----------------------------------
    local nx, ny, nz = 0, 0, 1
    if nm then
        local px = Pixel()
        local fx = clampf(ax, 0, 1) * (nm.Width - 1)
        local fy = clampf(ay, 0, 1) * (nm.Height - 1)
        local ix = math.floor(fx)
        local iy = math.floor(fy)
        if ix > nm.Width - 2 then ix = math.max(0, nm.Width - 2) end
        if iy > nm.Height - 2 then iy = math.max(0, nm.Height - 2) end
        local tx, ty = fx - ix, fy - iy
        local sx, sy, sz = 0, 0, 0
        for j = 0, 1 do
            for i = 0, 1 do
                nm:GetPixel(ix + i, iy + j, px)
                local wgt = (i == 0 and 1 - tx or tx) * (j == 0 and 1 - ty or ty)
                sx = sx + px.R * wgt
                sy = sy + px.G * wgt
                sz = sz + px.B * wgt
            end
        end
        nx, ny, nz = sx * 2 - 1, sy * 2 - 1, sz * 2 - 1
        if flipY then ny = -ny end
        local nl = math.sqrt(nx * nx + ny * ny + nz * nz)
        if nl < 1e-6 then
            nx, ny, nz = 0, 0, 1
        else
            nx, ny, nz = nx / nl, ny / nl, nz / nl
        end
        -- a normal pointing away from the camera cannot be seen; keep the plane
        if nz < 0 then nx, ny, nz = -nx, -ny, -nz end
    end

    -- orthonormal tangents: ty follows camera up, tx completes the frame -----
    local upx, upy, upz = 0, 1, 0
    local d = upx * nx + upy * ny + upz * nz
    local ux, uy, uz = upx - d * nx, upy - d * ny, upz - d * nz
    local ul = math.sqrt(ux * ux + uy * uy + uz * uz)
    if ul < 0.05 then
        -- degenerates on a face pointing straight up: use the view axis instead
        upx, upy, upz = 0, 0, -1
        d = upx * nx + upy * ny + upz * nz
        ux, uy, uz = upx - d * nx, upy - d * ny, upz - d * nz
        ul = math.sqrt(ux * ux + uy * uy + uz * uz)
        if ul < 1e-4 then ux, uy, uz, ul = 0, 1, 0, 1 end
    end
    local tyx, tyy, tyz = ux / ul, uy / ul, uz / ul
    -- tx = ty x n, unit because ty and n are unit and perpendicular
    local txx = tyy * nz - tyz * ny
    local txy = tyz * nx - tyx * nz
    local mx, my = txx, txy

    -- 2x2 matrix [[mx, tyx], [my, tyy]] maps plane coords to screen delta.
    local det = mx * tyy - tyx * my
    if math.abs(det) < 1e-6 then det = 1e-6 end

    local cs, sn = math.cos(rot), math.sin(rot)
    local invSize = 1 / size
    local invSizeY = 1 / (size * aspect)
    local aspectFrame = w / h

    local fgW, fgH = 0, 0
    if fg then fgW, fgH = fg.Width, fg.Height end

    local dst = Image({ IMG_Like = bg })
    local pb = Pixel()
    local pf = Pixel()

    local copied = pcall(function()
        dst:MultiProcessPixels(nil, {}, 0, 0, w, h, bg, passthrough)
    end)

    local reach = (size * h * 0.5) / math.max(0.2, math.abs(math.min(mx, tyy))) * (1 + edgeSoft * 2) + 6
    reach = math.min(reach, size * h * 4 + 8)
    local x0, x1, y0, y1 = 0, w - 1, 0, h - 1
    if copied and view == 0 then
        x0 = math.max(0, math.floor(ax * w - reach))
        x1 = math.min(w - 1, math.ceil(ax * w + reach))
        y0 = math.max(0, math.floor(ay * h - reach))
        y1 = math.min(h - 1, math.ceil(ay * h + reach))
    end

    local invW, invH = 1 / w, 1 / h

    for y = y0, y1 do
        local v = (y + 0.5) * invH
        local ey = v - ay
        for x = x0, x1 do
            bg:GetPixel(x, y, pb)
            local u = (x + 0.5) * invW
            local ex = (u - ax) * aspectFrame

            -- invert the tangent frame: screen delta -> plane coordinates
            local a = (tyy * ex - tyx * ey) / det
            local b = (-my * ex + mx * ey) / det
            local ra = cs * a - sn * b
            local rb = sn * a + cs * b
            local fu = 0.5 + ra * invSize
            local fv = 0.5 + rb * invSizeY

            local du = math.abs(fu - 0.5) * 2
            local dv = math.abs(fv - 0.5) * 2
            local dist = du > dv and du or dv
            local coverage = 1 - smoothstep(1 - edgeSoft, 1, dist)

            local outR, outG, outB = pb.R, pb.G, pb.B

            if coverage > 0.0001 and fg then
                local fxq = fu * (fgW - 1)
                local fyq = fv * (fgH - 1)
                local ix = math.floor(fxq)
                local iy = math.floor(fyq)
                local fr, fgc, fb, fa = 0, 0, 0, 0
                if ix >= 0 and iy >= 0 and ix < fgW - 1 and iy < fgH - 1 then
                    local tx, ty = fxq - ix, fyq - iy
                    for j = 0, 1 do
                        for i = 0, 1 do
                            fg:GetPixel(ix + i, iy + j, pf)
                            local wgt = (i == 0 and 1 - tx or tx) * (j == 0 and 1 - ty or ty)
                            fr = fr + pf.R * wgt
                            fgc = fgc + pf.G * wgt
                            fb = fb + pf.B * wgt
                            fa = fa + pf.A * wgt
                        end
                    end
                end
                if fa > 0 and fa < 1 then
                    local inv = 1 / fa
                    fr, fgc, fb = fr * inv, fgc * inv, fb * inv
                end
                local vis = clampf(coverage * fa * opacity, 0, 1)
                if vis > 0.0001 then
                    local br2, bg2, bb2 = blendRGB(blendMode + 1, pb.R, pb.G, pb.B, fr, fgc, fb)
                    outR = pb.R * (1 - vis) + br2 * vis
                    outG = pb.G * (1 - vis) + bg2 * vis
                    outB = pb.B * (1 - vis) + bb2 * vis
                end
            end

            if view == 1 then
                -- paint the two tangent axes: red along u, green along v
                local axisU = math.min(du, 0.02)
                local axisV = math.min(dv, 0.02)
                outR = clampf(pb.R + (1 - smoothstep(0, 0.02, axisU * 0.5 + axisV)) * 0.8, 0, 1)
                outG = clampf(pb.G + (1 - smoothstep(0, 0.02, axisV * 0.5 + axisU)) * 0.8, 0, 1)
                outB = pb.B
            end

            pb.R, pb.G, pb.B = outR, outG, outB
            dst:SetPixel(x, y, pb)
        end
    end

    local dt = os.clock() - t0
    if dt > 1.0 then logline(string.format("frame %dx%d %.2fs box %d..%d x %d..%d copy=%s", w, h, dt, x0, x1, y0, y1, tostring(copied))) end
    OutImage:Set(req, dst)
end

function Process(req)
    local ok, err = pcall(doProcess, req)
    if not ok then
        logline("ERROR " .. tostring(err))
        local bg = InBackground:GetValue(req)
        if bg then OutImage:Set(req, bg) end
    end
end






