-- PSN_Threshold 1.0. Independently calibrated against Photoshop 27.2 RGB output.
FuRegisterClass("PSN_Threshold",CT_Tool,{
    REGS_Name="PSN_Threshold",REGS_Category="PSN\\Color",REGS_OpIconString="Thr",
    REGS_OpDescription="Photoshop-style black and white Threshold",
    REG_NoMotionBlurCtrls=true,
})
function Create()
    InImage=self:AddInput("Input","Input",{LINKID_DataType="Image",LINK_Main=1,INP_AcceptsDoD=false})
    OutImage=self:AddOutput("Output","Output",{LINKID_DataType="Image",LINK_Main=1})
    InLevel=self:AddInput("Threshold Level","Threshold",{
        LINKID_DataType="Number",INPID_InputControl="SliderControl",INP_Integer=true,
        INP_Default=128,INP_MinScale=1,INP_MaxScale=255,INP_MinAllowed=1,INP_MaxAllowed=255,
    })
    InPreview=self:AddInput("Preview","Preview",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    self:BeginControlNest("Fusion Options","FusionOptions",false,{})
    InSpace=self:AddInput("Input encoding","InputEncoding",{
        LINKID_DataType="Number",INPID_InputControl="ComboControl",INP_Default=0,
        {CCS_AddString="RGB as supplied (Photoshop-style)"},
        {CCS_AddString="Linear sRGB / Rec.709 primaries"},
    })
    InAlpha=self:AddInput("Pre-Divide / Post-Multiply","PreDivide",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
        INPS_StatusText="On for premultiplied RGB; off for straight RGB. Alpha is preserved.",
    })
    self:EndControlNest()
end
local thresholdPixel=function(x,y,p)
    if p.A<=0 then p.R,p.G,p.B=0,0,0; return p end
    local factor=premultiplied and p.A or 1
    local r,g,b=p.R/factor,p.G/factor,p.B/factor
    if linear then
        r=r<=0.0031308 and 12.92*r or 1.055*r^(1/2.4)-0.055
        g=g<=0.0031308 and 12.92*g or 1.055*g^(1/2.4)-0.055
        b=b<=0.0031308 and 12.92*b or 1.055*b^(1/2.4)-0.055
    end
    r,g,b=math.max(0,math.min(1,r)),math.max(0,math.min(1,g)),math.max(0,math.min(1,b))
    -- Photoshop's tested 8-bit RGB cutoff: 30/59/11 brightness, half ties black.
    -- Tolerance absorbs float32 transport error at exact byte-valued boundaries.
    local value=(255*(0.30*r+0.59*g+0.11*b)>level-0.5+0.00002) and factor or 0
    p.R,p.G,p.B=value,value,value
    return p
end
function Process(req)
    local src=InImage:GetValue(req)
    if not src then return end
    if InPreview:GetValue(req).Value<0.5 then OutImage:Set(req,src); return end
    src:DownloadGPUMem(req)
    local dst=Image({IMG_Like=src})
    dst:MultiProcessPixels(nil,{
        level=math.max(1,math.min(255,math.floor(InLevel:GetValue(req).Value+0.5))),
        premultiplied=InAlpha:GetValue(req).Value>0.5,linear=InSpace:GetValue(req).Value>0.5,
    },0,0,src.Width,src.Height,src,thresholdPixel)
    OutImage:Set(req,dst)
end
