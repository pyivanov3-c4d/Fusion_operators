-- PSN_CleanSharp 1.0: high-pass detail blended over the original with Overlay.
FuRegisterClass("PSN_CleanSharp", CT_Tool, {
    REGS_Name="PSN_CleanSharp", REGS_Category="PSN\\Color",
    REGS_OpIconString="CSh", REGS_OpDescription="High Pass sharpening with Overlay blending",
    REG_NoMotionBlurCtrls=true,
})

function Create()
    InImage=self:AddInput("Input","Input",{LINKID_DataType="Image",LINK_Main=1,INP_AcceptsDoD=false})
    OutImage=self:AddOutput("Output","Output",{LINKID_DataType="Image",LINK_Main=1})
    InRadius=self:AddInput("Radius (pixels)","Radius",{
        LINKID_DataType="Number",INPID_InputControl="SliderControl",
        INP_Default=10,INP_MinScale=0,INP_MaxScale=100,INP_MinAllowed=0,INP_MaxAllowed=1000,
    })
    InIntensity=self:AddInput("Intensity (%)","Intensity",{
        LINKID_DataType="Number",INPID_InputControl="SliderControl",
        INP_Default=20,INP_MinScale=0,INP_MaxScale=100,INP_MinAllowed=0,INP_MaxAllowed=100,
    })
    InHighPass=self:AddInput("Show High Pass","ShowHighPass",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=0,
    })
    InPreview=self:AddInput("Preview","Preview",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    self:BeginControlNest("Fusion Options","FusionOptions",false,{})
    InAlpha=self:AddInput("Pre-Divide / Post-Multiply","PreDivide",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
        INPS_StatusText="On for premultiplied RGB; off for straight RGB. Alpha is preserved.",
    })
    self:EndControlNest()
end

local prepare=function(x,y,p)
    if not premultiplied then p.R,p.G,p.B=p.R*p.A,p.G*p.A,p.B*p.A end
    return p
end

local combine=function(x,y,p,q)
    if p.A<=0 then return p end
    local scale=premultiplied and p.A or 1
    local values={p.R/scale,p.G/scale,p.B/scale}
    local blurred={q.R,q.G,q.B}
    for i=1,3 do
        local original=values[i]
        local low=q.A>0.000001 and blurred[i]/q.A or original
        local hp=math.max(0,math.min(1,0.5+original-low))
        local base=math.max(0,math.min(1,original))
        local overlay=base<=0.5 and 2*base*hp or 1-2*(1-base)*(1-hp)
        values[i]=(showHighPass and hp or original+amount*(overlay-base))*scale
    end
    p.R,p.G,p.B=values[1],values[2],values[3]
    return p
end

function Process(req)
    local src=InImage:GetValue(req)
    if not src then return end
    local radius=math.max(0,InRadius:GetValue(req).Value)
    local amount=math.max(0,math.min(1,InIntensity:GetValue(req).Value/100))
    local show=InHighPass:GetValue(req).Value>0.5
    if InPreview:GetValue(req).Value<0.5 or (not show and (amount==0 or radius==0)) then
        OutImage:Set(req,src); return
    end
    local premultiplied=InAlpha:GetValue(req).Value>0.5
    src:DownloadGPUMem(req)
    local work=Image({IMG_Like=src,IMG_Depth=8})
    work:MultiProcessPixels(nil,{premultiplied=premultiplied},0,0,src.Width,src.Height,src,prepare)
    local blurred=Image({IMG_Like=work})
    if radius>0 then
        -- Fusion Gaussian width calibration (approximately 2*sqrt(2*ln(2))).
        -- Compared with Photoshop 27.2 at 1, 10 and 30 pixels; not bit-exact.
        work:Blur(blurred,{BLUR_Type="Gaussian",BLUR_XSize=(radius*2.35482)/src.OriginalWidth,
            BLUR_YSize=(radius*2.35482)/src.OriginalWidth,BLUR_Red=true,BLUR_Green=true,BLUR_Blue=true,BLUR_Alpha=true})
    else blurred=work end
    local dst=Image({IMG_Like=work})
    dst:MultiProcessPixels(nil,{premultiplied=premultiplied,amount=amount,showHighPass=show},
        0,0,src.Width,src.Height,src,blurred,combine)
    OutImage:Set(req,dst)
end


