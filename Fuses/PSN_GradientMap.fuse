-- PSN_GradientMap 1.0
-- Photoshop-style solid Gradient Map. Interpolation informed by Patchy's
-- MIT-licensed gradient calibration; license notice included below.
FuRegisterClass("PSN_GradientMap",CT_Tool,{
    REGS_Name="PSN_GradientMap",REGS_Category="PSN\\Color",REGS_OpIconString="GMap",
    REGS_OpDescription="Map image brightness through an editable color gradient",
    REG_NoMotionBlurCtrls=true,
})
function Create()
    InImage=self:AddInput("Input","Input",{LINKID_DataType="Image",LINK_Main=1,INP_AcceptsDoD=false})
    OutImage=self:AddOutput("Output","Output",{LINKID_DataType="Image",LINK_Main=1})
    InGradient=self:AddInput("Gradient","Gradient",{
        LINKID_DataType="Gradient",INPID_InputControl="GradientControl",INP_DelayDefault=true,
    })
    InMethod=self:AddInput("Method","Method",{
        LINKID_DataType="Number",INPID_InputControl="ComboControl",INP_Default=0,INP_Integer=true,
        {CCS_AddString="Perceptual"},{CCS_AddString="Linear"},{CCS_AddString="Classic"},
    })
    InSmooth=self:AddInput("Smoothness (%)","Smoothness",{
        LINKID_DataType="Number",INPID_InputControl="SliderControl",INP_Default=100,
        INP_MinScale=0,INP_MaxScale=100,INP_MinAllowed=0,INP_MaxAllowed=100,
    })
    InReverse=self:AddInput("Reverse","Reverse",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=0,
    })
    InPreview=self:AddInput("Preview","Preview",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    self:BeginControlNest("Fusion Options","FusionOptions",false,{})
    InSpace=self:AddInput("Input encoding","InputEncoding",{
        LINKID_DataType="Number",INPID_InputControl="ComboControl",INP_Default=0,
        {CCS_AddString="sRGB (Photoshop-style)"},{CCS_AddString="Linear sRGB / Rec.709 primaries"},
    })
    InQuantize=self:AddInput("Match Photoshop 8-bit tones","Match8Bit",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    InAlpha=self:AddInput("Pre-Divide / Post-Multiply","PreDivide",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    self:EndControlNest()
end
local function clamp(x) return math.max(0,math.min(1,x)) end
local function decode(x) return x<=.04045 and x/12.92 or ((x+.055)/1.055)^2.4 end
local function encode(x) return x<=.0031308 and 12.92*x or 1.055*x^(1/2.4)-.055 end
local function lab(c)
    local r,g,b=decode(c[1]),decode(c[2]),decode(c[3])
    local l=(.4122214708*r+.5363325363*g+.0514459929*b)^(1/3)
    local m=(.2119034982*r+.6806995451*g+.1073969566*b)^(1/3)
    local s=(.0883024619*r+.2817188376*g+.6299787005*b)^(1/3)
    return {.2104542553*l+.793617785*m-.0040720468*s,1.9779984951*l-2.428592205*m+.4505937099*s,.0259040371*l+.7827717662*m-.808675766*s}
end
local function unlab(c)
    local l=(c[1]+.3963377774*c[2]+.2158037573*c[3])^3
    local m=(c[1]-.1055613458*c[2]-.0638541728*c[3])^3
    local s=(c[1]-.0894841775*c[2]-1.291485548*c[3])^3
    return {clamp(encode(4.0767416621*l-3.3077115913*m+.2309699292*s)),
        clamp(encode(-1.2684380046*l+2.6097574011*m-.3413193965*s)),
        clamp(encode(-.0041960863*l-.7034186147*m+1.707614701*s))}
end
local function cubic(a,b,c,d,t)
    return .5*((2*b)+(-a+c)*t+(2*a-5*b+4*c-d)*t*t+(-a+3*b-3*c+d)*t*t*t)
end
local function sample(stops,x,method,smooth)
    if x<=stops[1].pos then return stops[1].color end
    if x>=stops[#stops].pos then return stops[#stops].color end
    for i=2,#stops do
        local a,b=stops[i-1],stops[i]
        if x<=b.pos then
            local t=(x-a.pos)/math.max(.000001,b.pos-a.pos)
            local out={}
            if method==2 then
                local prev=stops[math.max(1,i-2)].color
                local next=stops[math.min(#stops,i+1)].color
                for j=1,3 do
                    local straight=a.color[j]+(b.color[j]-a.color[j])*t
                    out[j]=clamp(straight+smooth*(cubic(prev[j],a.color[j],b.color[j],next[j],t)-straight))
                end
            else
                t=t+smooth*(cubic(0,0,1,1,t)-t)
                for j=1,3 do out[j]=a.space[j]+(b.space[j]-a.space[j])*t end
                if method==0 then out=unlab(out)
                else for j=1,3 do out[j]=clamp(encode(out[j])) end end
            end
            return out
        end
    end
end
local pixel=function(x,y,p)
    if p.A<=0 then return p end
    local scale=premultiplied and p.A or 1
    local r,g,b=p.R/scale,p.G/scale,p.B/scale
    if linear then
        r=r<=.0031308 and 12.92*r or 1.055*r^(1/2.4)-.055
        g=g<=.0031308 and 12.92*g or 1.055*g^(1/2.4)-.055
        b=b<=.0031308 and 12.92*b or 1.055*b^(1/2.4)-.055
    end
    local yv=math.max(0,math.min(1,.30*r+.59*g+.11*b))
    if quantize then yv=math.floor(yv*255+.5)/255 end
    if reverse then yv=1-yv end
    local pos=yv*size;local i=math.min(size-1,math.floor(pos));local w=pos-i
    local out={}
    for j=1,3 do
        local v=lut[i+1][j]*(1-w)+lut[i+2][j]*w
        if linear then v=v<=.04045 and v/12.92 or ((v+.055)/1.055)^2.4 end
        out[j]=v*scale
    end
    p.R,p.G,p.B=out[1],out[2],out[3];return p
end
function Process(req)
    local src=InImage:GetValue(req);if not src then return end
    if InPreview:GetValue(req).Value<.5 then OutImage:Set(req,src);return end
    local grad=InGradient:GetValue(req); local p=grad:GetColor(.5);print("HALF",p.R,p.G,p.B); local q=grad:QuickEvaluate(.5,"RGB"); print("EVAL",q.R,q.G,q.B)
    local method=math.floor(InMethod:GetValue(req).Value+.5)
    local smooth=clamp(InSmooth:GetValue(req).Value/100)
    local stops={}
    for pos,c in pairs(grad.Value) do
        if type(pos)=="number" and type(c)=="table" then
            local rgb={clamp(c[1]),clamp(c[2]),clamp(c[3])}
            local converted=method==0 and lab(rgb) or {decode(rgb[1]),decode(rgb[2]),decode(rgb[3])}
            stops[#stops+1]={pos=pos,color=rgb,space=converted}
        end
    end
    table.sort(stops,function(a,b)return a.pos<b.pos end)
    if #stops==0 then OutImage:Set(req,src);return end
    local quantize=InQuantize:GetValue(req).Value>.5
    local size=quantize and 255 or 4096
    local lut={}
    for i=0,size do lut[i+1]=sample(stops,i/size,method,smooth) end
    src:DownloadGPUMem(req)
    local dst=Image({IMG_Like=src,IMG_Depth=8})
    dst:MultiProcessPixels(nil,{lut=lut,size=size,quantize=quantize,
        reverse=InReverse:GetValue(req).Value>.5,premultiplied=InAlpha:GetValue(req).Value>.5,
        linear=InSpace:GetValue(req).Value>.5},0,0,src.Width,src.Height,src,pixel)
    OutImage:Set(req,dst)
end

