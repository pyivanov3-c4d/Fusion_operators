-- PSN_FigmaAdjustment 3.0
-- Figma image-adjustment mathematics, independently implemented for Fusion.
-- Validated against Figma PNG exports; see PSN_FigmaAdjustment.md.
FuRegisterClass("PSN_FigmaAdjustment", CT_Tool, {
    REGS_Name = "PSN_FigmaAdjustment",
    REGS_Category = "PSN\\Color",
    REGS_OpIconString = "Fig",
    REGS_OpDescription = "Figma-style image adjustments (CIELAB): Exposure, Contrast, Saturation, Temperature, Tint, Highlights, Shadows",
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

function Create()
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image", LINK_Main = 1, INP_AcceptsDoD = false,
    })
    OutImage = self:AddOutput("Output", "Output", {LINKID_DataType = "Image", LINK_Main = 1})
    local function slider(name, id, tip)
        return self:AddInput(name, id, {
            LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
            INP_Default = 0, INP_Integer = true,
            INP_MinScale = -100, INP_MaxScale = 100,
            INP_MinAllowed = -100, INP_MaxAllowed = 100,
            INPS_StatusText = tip,
        })
    end
    InExposure = slider("Exposure", "Exposure", "Figma Exposure: overall brightness with color compensation.")
    InContrast = slider("Contrast", "Contrast", "Figma Contrast: perceptual contrast; negative values soften the image.")
    InSaturation = slider("Saturation", "Saturation", "Figma Saturation: -100 is grayscale; positive values preserve the RGB gamut.")
    InTemperature = slider("Temperature", "Temperature", "Figma Temperature: cool to warm.")
    InTint = slider("Tint", "Tint", "Figma Tint: green to magenta.")
    InHighlights = slider("Highlights", "Highlights", "Figma Highlights: adjust bright areas based on original image luminance.")
    InShadows = slider("Shadows", "Shadows", "Figma Shadows: adjust dark areas based on original image luminance.")
    InPreview = self:AddInput("Preview", "Preview", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
        INPS_StatusText = "Bypass the adjustment.",
    })
    self:BeginControlNest("Fusion Options", "FusionOptions", false, {})
    InSpace = self:AddInput("Input encoding", "InputEncoding", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0,
        {CCS_AddString = "RGB as supplied (Figma-style)"},
        {CCS_AddString = "Linear sRGB / Rec.709 primaries"},
        INPS_StatusText = "Figma works on gamma-encoded RGB. The linear option treats input as linear sRGB.",
    })
    InAlpha = self:AddInput("Pre-Divide / Post-Multiply", "PreDivide", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
        INPS_StatusText = "Unpremultiply before adjusting, then restore alpha.",
    })
    InMatch8Bit = self:AddInput("Figma 8-bit rounding", "Match8Bit", {
        LINKID_DataType="Number", INPID_InputControl="CheckboxControl", INP_Default=1,
        INPS_StatusText="On: round adjusted RGB like Figma's 8-bit image export. Off: preserve floating-point precision.",
    })
    self:EndControlNest()
end

-- All functions used here are local to the worker or passed as scalar settings.
local processPixel = function(x, y, p)
    local alpha = p.A
    if premultiplied and alpha <= 0 then return p end
    local factor = premultiplied and alpha or 1
    local originalR, originalG, originalB = p.R/factor, p.G/factor, p.B/factor
    local r = math.max(0,math.min(1,originalR))
    local g = math.max(0,math.min(1,originalG))
    local b = math.max(0,math.min(1,originalB))
    local residualR,residualG,residualB=originalR-r,originalG-g,originalB-b
    if linearInput then
        r=r<=.0031308 and 12.92*r or 1.055*r^(1/2.4)-.055
        g=g<=.0031308 and 12.92*g or 1.055*g^(1/2.4)-.055
        b=b<=.0031308 and 12.92*b or 1.055*b^(1/2.4)-.055
    end
    r,g,b=r^2.2,g^2.2,b^2.2
    -- Local tonal weights come from the ORIGINAL image, before color/contrast.
    local originalLuma=.2126*r+.7152*g+.0722*b
    local distance=originalLuma-.5^2.2
    local localExposure=.75*distance/math.sqrt(1+4*distance*distance)
        *(distance>0 and highlights or -.999*shadows)

    -- Figma uses a cube-root Lab transform throughout, including dark values.
    local fx=((.4124564*r+.3575761*g+.1804375*b)/.95047)^(1/3)
    local fy=(.2126729*r+.7151522*g+.0721750*b)^(1/3)
    local fz=((.0193339*r+.1191920*g+.9503041*b)/1.08883)^(1/3)
    local light=1.16*fy-.16
    local changed=light
    if contrast<0 then
        changed=light+(-contrast)*((light-.5)*.2+.5-light)
    elseif contrast>0 then
        local t=math.max(0,math.min(1,(light-.2)/.6))
        local smooth=t*t*t*(t*(6*t-15)+10)
        changed=light+contrast*(smooth-light)
    end
    local delta=(changed-light)/1.16
    fx,fy,fz=fx+delta+.06*tint,fy+delta,fz+delta-.15*temperature
    local X,Y,Z=fx*fx*fx*.95047,fy*fy*fy,fz*fz*fz*1.08883
    r=math.max(0,math.min(1,3.2404542*X-1.5371385*Y-.4985314*Z))
    g=math.max(0,math.min(1,-.9692660*X+1.8760108*Y+.0415560*Z))
    b=math.max(0,math.min(1,.0556434*X-.2040259*Y+1.0572252*Z))

    local ev=exposure+localExposure
    local luma=.2126*r+.7152*g+.0722*b
    local negative=math.min(0,ev)
    local restore=3*(1+luma*luma*negative/(.2-negative))
    local scale=1+negative/16
    r,g,b=(.25*r+.75*luma)*scale,(.25*g+.75*luma)*scale,(.25*b+.75*luma)*scale
    luma=luma*scale
    local gain=10^(2*ev)
    local curve=gain-1
    r,g,b=gain*r/(1+curve*r),gain*g/(1+curve*g),gain*b/(1+curve*b)
    local gray=gain*luma/(1+curve*luma)
    r=math.max(0,math.min(1,r+(r-gray)*restore))
    g=math.max(0,math.min(1,g+(g-gray)*restore))
    b=math.max(0,math.min(1,b+(b-gray)*restore))

    luma=.2126*r+.7152*g+.0722*b
    local satGain=1+saturation
    if saturation>0 then
        local darkLimit=luma/(luma-math.min(r,g,b)+1e-6)
        local lightLimit=(1-luma)/(math.max(r,g,b)-luma+1e-6)
        satGain=math.min(2,1+saturation*(math.min(darkLimit,lightLimit)-1))
    end
    r=math.max(0,math.min(1,luma+(r-luma)*satGain))^(1/2.2)
    g=math.max(0,math.min(1,luma+(g-luma)*satGain))^(1/2.2)
    b=math.max(0,math.min(1,luma+(b-luma)*satGain))^(1/2.2)
    if match8bit then
        r,g,b=math.floor(r*255+.5)/255,math.floor(g*255+.5)/255,math.floor(b*255+.5)/255
    end
    if linearInput then
        r=r<=.04045 and r/12.92 or ((r+.055)/1.055)^2.4
        g=g<=.04045 and g/12.92 or ((g+.055)/1.055)^2.4
        b=b<=.04045 and b/12.92 or ((b+.055)/1.055)^2.4
    end
    p.R,p.G,p.B=(r+residualR)*factor,(g+residualG)*factor,(b+residualB)*factor
    return p
end

function Process(req)
    local src=InImage:GetValue(req)
    if not src then return end
    local function value(input) return math.max(-100,math.min(100,input:GetValue(req).Value))/100 end
    local e,c,s,t,n,h,d=value(InExposure),value(InContrast),value(InSaturation),value(InTemperature),value(InTint),value(InHighlights),value(InShadows)
    if InPreview:GetValue(req).Value<.5 or (e==0 and c==0 and s==0 and t==0 and n==0 and h==0 and d==0) then
        OutImage:Set(req,src);return
    end
    src:DownloadGPUMem(req)
    local dst=Image({IMG_Like=src,IMG_Depth=8})
    dst:MultiProcessPixels(nil,{
        exposure=e,contrast=c*.3,saturation=s,temperature=t,tint=n,highlights=h,shadows=d,
        premultiplied=InAlpha:GetValue(req).Value>.5,linearInput=InSpace:GetValue(req).Value>.5,
        match8bit=InMatch8Bit:GetValue(req).Value>.5,
    },0,0,src.Width,src.Height,src,processPixel)
    OutImage:Set(req,dst)
end
