-- PSN_FigmaAdjustment 2.0
-- Figma-style image adjustments, rebuilt from measurements of Figma's own renderer.
--
-- Measured against 93 exports from Figma Desktop (app 126.10.13) on a grey/colour chart:
-- Figma's seven sliders are CIELAB (D65) operations, not an RGB gamma pipeline.
--   Temperature : b* += 29.3 * t   (L* and a* unchanged)
--   Tint        : a* += 29.3 * n   (L* and b* unchanged)
--   Saturation  : chroma scaled, L* unchanged
--   Contrast / Highlights / Shadows : L* only; highlights act above L* 53.6, shadows below
--   Exposure    : L* tone curve that also compresses chroma
-- The L* curves below were measured at thirteen slider values and are interpolated at
-- render time (51 knots of L* = 0,2,...,100).
FuRegisterClass("PSN_FigmaAdjustment", CT_Tool, {
    REGS_Name = "PSN_FigmaAdjustment",
    REGS_Category = "PSN\\Color",
    REGS_OpIconString = "Fig",
    REGS_OpDescription = "Figma-style image adjustments (CIELAB): Exposure, Contrast, Saturation, Temperature, Tint, Highlights, Shadows",
    REG_NoMotionBlurCtrls = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

local LUT_SIZE = 4096
local PVALS = {-1, -0.75, -0.5, -0.25, -0.1, -0.01, 0, 0.01, 0.1, 0.25, 0.5, 0.75, 1}

