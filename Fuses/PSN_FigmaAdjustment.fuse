local function buildTables()
    local dec, enc = {}, {}
    for i = 0, LUT_SIZE do
        local v = i / LUT_SIZE
        dec[i + 1] = v <= 0.04045 and v / 12.92 or ((v + 0.055) / 1.055) ^ 2.4
        enc[i + 1] = v <= 0.0031308 and v * 12.92 or 1.055 * v ^ (1 / 2.4) - 0.055
    end
    return dec, enc
end
local DECODE, ENCODE = buildTables()

-- Largest CIELAB chroma that still fits sRGB, sampled by L* and hue. Figma's exposure
-- desaturates as it lifts: measured outputs sit on this boundary (a lifted pure green
-- becomes near-white, not a brighter green).
local CLIFT = {0, 0, 0, 0, 0, 0, 0, 0, 0.10, 0.50, 1.80, 3.00, 3.00}
local CHUE = 64
local CLMAX = 33
local CMAX = {}
do
    for li = 0, CLMAX do
        local L = li * 100 / CLMAX
        for hi = 0, CHUE - 1 do
            local ang = hi * 2 * math.pi / CHUE
            local ca, sa = math.cos(ang), math.sin(ang)
            local lo, up = 0, 180
            for _ = 1, 22 do
                local mid = (lo + up) * 0.5
                local fy = (L + 16) / 116
                local fx = fy + mid * ca / 500
                local fz = fy - mid * sa / 200
                local X = (fx > 0.2069 and fx * fx * fx or (116 * fx - 16) / 903.3) * 0.95047
                local Y = fy > 0.2069 and fy * fy * fy or (116 * fy - 16) / 903.3
                local Z = (fz > 0.2069 and fz * fz * fz or (116 * fz - 16) / 903.3) * 1.08883
                local r = 3.2404542 * X - 1.5371385 * Y - 0.4985314 * Z
                local g = -0.9692660 * X + 1.8760108 * Y + 0.0415560 * Z
                local bb = 0.0556434 * X - 0.2040259 * Y + 1.0572252 * Z
                if r >= -0.0001 and r <= 1.0001 and g >= -0.0001 and g <= 1.0001
                    and bb >= -0.0001 and bb <= 1.0001 then
                    lo = mid
                else
                    up = mid
                end
            end
            CMAX[li * CHUE + hi + 1] = lo
        end
    end
end


-- Helpers used from the per-pixel environment (passed through the env table).
function curveL(curve, v, L, pv)
    local n = #pv
    local i
    if v <= pv[1] then i = 1
    elseif v >= pv[n] then i = n - 1
    else
        for k = 1, n - 1 do
            if v <= pv[k + 1] then i = k; break end
        end
    end
    local f = (v - pv[i]) / (pv[i + 1] - pv[i])
    if f < 0 then f = 0 elseif f > 1 then f = 1 end
    if L < 0 then L = 0 elseif L > 100 then L = 100 end
    local pos = L * 0.5
    local j = math.floor(pos)
    if j > 49 then j = 49 end
    local t = pos - j
    local o1 = (i - 1) * 51 + j + 1
    local o2 = i * 51 + j + 1
    local a = curve[o1] + (curve[o1 + 1] - curve[o1]) * t
    local bb = curve[o2] + (curve[o2 + 1] - curve[o2]) * t
    return a + (bb - a) * f
end

function encodeL(x, enc, n)
    if x <= 0 then return 0 elseif x >= 1 then return 1 end
    local p = x * n
    local i = math.floor(p)
    if i >= n then i = n - 1 end
    local f = p - i
    return enc[i + 1] + (enc[i + 2] - enc[i + 1]) * f
end

function Create()
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image", LINK_Main = 1, INP_AcceptsDoD = false,
    })
    OutImage = self:AddOutput("Output", "Output", {LINKID_DataType = "Image", LINK_Main = 1})
    local function slider(name, id, tip)
        return self:AddInput(name, id, {
            LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
            INP_Default = 0, INP_Integer = true,
            INP_MinScale = -100, INP_MaxScale = 100,
            INP_MinAllowed = -100, INP_MaxAllowed = 100,
            INPS_StatusText = tip,
        })
    end
    InExposure = slider("Exposure", "Exposure", "Figma Exposure: overall light, driven through CIELAB L*.")
    InContrast = slider("Contrast", "Contrast", "Figma Contrast: L* only; negative mutes toward mid-grey.")
    InSaturation = slider("Saturation", "Saturation", "Figma Saturation: chroma scale in CIELAB; -100 is grey.")
    InTemperature = slider("Temperature", "Temperature", "Figma Temperature: b* shift (+29.3 at +100); negative is cooler.")
    InTint = slider("Tint", "Tint", "Figma Tint: a* shift (+29.3 at +100); negative is green.")
    InHighlights = slider("Highlights", "Highlights", "Figma Highlights: L* above 53.6 only.")
    InShadows = slider("Shadows", "Shadows", "Figma Shadows: L* below 53.6 only.")
    InPreview = self:AddInput("Preview", "Preview", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
        INPS_StatusText = "Bypass the adjustment.",
    })
    self:BeginControlNest("Fusion Options", "FusionOptions", false, {})
    InSpace = self:AddInput("Input encoding", "InputEncoding", {
        LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0,
        {CCS_AddString = "RGB as supplied (Figma-style)"},
        {CCS_AddString = "Linear sRGB / Rec.709 primaries"},
        INPS_StatusText = "Figma works on gamma-encoded RGB. The linear option treats input as linear sRGB.",
    })
    InAlpha = self:AddInput("Pre-Divide / Post-Multiply", "PreDivide", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
        INPS_StatusText = "Unpremultiply before adjusting, then restore alpha.",
    })
    self:EndControlNest()
end

-- Runs with a per-thread environment from MultiProcessPixels: it only reads values
-- from that environment (no helper functions, no upvalues), because the callback is
-- serialised to worker threads.
local processPixel = function(x, y, p)
    local alpha = p.A
    if unpremultiply and alpha <= 0 then return p end
    local factor = unpremultiply and alpha or 1
    local r, g, b = p.R / factor, p.G / factor, p.B / factor
    local cr = r < 0 and 0 or (r > 1 and 1 or r)
    local cg = g < 0 and 0 or (g > 1 and 1 or g)
    local cb = b < 0 and 0 or (b > 1 and 1 or b)

    local dr = DEC[math.floor(cr * LUTN) + 1]
    local dg = DEC[math.floor(cg * LUTN) + 1]
    local db = DEC[math.floor(cb * LUTN) + 1]

    -- Exposure in linear light: Figma's response is a luminance gain plus a lift
    -- proportional to luminance, fitted from its own renders (lift 0 at neutral and
    -- negative, rising to 3.0 at +100). The gain keeps greys on Figma's measured curve.
    if eVal ~= 0 then
        local c = CL[1]
        local n = 13
        if eVal >= PV[n] then c = CL[n - 1]
        else
            for kk = 1, n - 1 do
                if eVal <= PV[kk + 1] then c = CL[kk] + (CL[kk + 1] - CL[kk]) * ((eVal - PV[kk]) / (PV[kk + 1] - PV[kk])); break end
            end
        end
        local Yl = 0.2126 * dr + 0.7152 * dg + 0.0722 * db
        local Lc = Yl > 0.008856 and 116 * Yl ^ (1 / 3) - 16 or 903.3 * Yl

        local ci = 1
        if eVal >= PV[13] then ci = 12
        elseif eVal > PV[1] then
            for kk = 1, 12 do
                if eVal <= PV[kk + 1] then ci = kk; break end
            end
        end
        local ff = (eVal - PV[ci]) / (PV[ci + 1] - PV[ci])
        if ff < 0 then ff = 0 elseif ff > 1 then ff = 1 end
        local ll = Lc
        if ll < 0 then ll = 0 elseif ll > 100 then ll = 100 end
        local pos = ll * 0.5
        local j = math.floor(pos)
        if j > 49 then j = 49 end
        local tt = pos - j
        local o1 = (ci - 1) * 51 + j + 1
        local o2 = ci * 51 + j + 1
        local a1 = CE[o1] + (CE[o1 + 1] - CE[o1]) * tt
        local a2 = CE[o2] + (CE[o2 + 1] - CE[o2]) * tt
        local Lp = a1 + (a2 - a1) * ff
        local T = Lp > 8 and ((Lp + 16) / 116) ^ 3 or Lp / 903.3
        local kk = (T - c * Yl) / (Yl > 0.000000001 and Yl or 0.000000001)
        dr = kk * dr + c * Yl
        dg = kk * dg + c * Yl
        db = kk * db + c * Yl
        if dr < 0 then dr = 0 elseif dr > 4 then dr = 4 end
        if dg < 0 then dg = 0 elseif dg > 4 then dg = 4 end
        if db < 0 then db = 0 elseif db > 4 then db = 4 end
    end

    local X = 0.4124564 * dr + 0.3575761 * dg + 0.1804375 * db
    local Y = 0.2126729 * dr + 0.7151522 * dg + 0.0721750 * db
    local Z = 0.0193339 * dr + 0.1191920 * dg + 0.9503041 * db

    local tx, ty, tz = X / 0.95047, Y, Z / 1.08883
    local fx = tx > 0.008856 and tx ^ (1 / 3) or (903.3 * tx + 16) / 116
    local fy = ty > 0.008856 and ty ^ (1 / 3) or (903.3 * ty + 16) / 116
    local fz = tz > 0.008856 and tz ^ (1 / 3) or (903.3 * tz + 16) / 116
    local L = 116 * fy - 16
    local A = 500 * (fx - fy)
    local B = 200 * (fy - fz)

    if kVal ~= 0 then
        local c = kVal <= PV1 and 1 or (kVal >= PV13 and 12 or 1)
        if kVal > PV1 and kVal < PV13 then
            for kk = 1, 12 do
                if kVal <= PV[kk + 1] then c = kk; break end
            end
        end
        local f = (kVal - PV[c]) / (PV[c + 1] - PV[c])
        if f < 0 then f = 0 elseif f > 1 then f = 1 end
        local l = L
        if l < 0 then l = 0 elseif l > 100 then l = 100 end
        local pos = l * 0.5
        local j = math.floor(pos)
        if j > 49 then j = 49 end
        local t = pos - j
        local o1 = (c - 1) * 51 + j + 1
        local o2 = c * 51 + j + 1
        local a1 = CK[o1] + (CK[o1 + 1] - CK[o1]) * t
        local a2 = CK[o2] + (CK[o2 + 1] - CK[o2]) * t
        L = a1 + (a2 - a1) * f
    end
    if hVal ~= 0 then
        local c = hVal <= PV1 and 1 or (hVal >= PV13 and 12 or 1)
        if hVal > PV1 and hVal < PV13 then
            for kk = 1, 12 do
                if hVal <= PV[kk + 1] then c = kk; break end
            end
        end
        local f = (hVal - PV[c]) / (PV[c + 1] - PV[c])
        if f < 0 then f = 0 elseif f > 1 then f = 1 end
        local l = L
        if l < 0 then l = 0 elseif l > 100 then l = 100 end
        local pos = l * 0.5
        local j = math.floor(pos)
        if j > 49 then j = 49 end
        local t = pos - j
        local o1 = (c - 1) * 51 + j + 1
        local o2 = c * 51 + j + 1
        local a1 = CH[o1] + (CH[o1 + 1] - CH[o1]) * t
        local a2 = CH[o2] + (CH[o2 + 1] - CH[o2]) * t
        L = a1 + (a2 - a1) * f
    end
    if sVal ~= 0 then
        local c = sVal <= PV1 and 1 or (sVal >= PV13 and 12 or 1)
        if sVal > PV1 and sVal < PV13 then
            for kk = 1, 12 do
                if sVal <= PV[kk + 1] then c = kk; break end
            end
        end
        local f = (sVal - PV[c]) / (PV[c + 1] - PV[c])
        if f < 0 then f = 0 elseif f > 1 then f = 1 end
        local l = L
        if l < 0 then l = 0 elseif l > 100 then l = 100 end
        local pos = l * 0.5
        local j = math.floor(pos)
        if j > 49 then j = 49 end
        local t = pos - j
        local o1 = (c - 1) * 51 + j + 1
        local o2 = c * 51 + j + 1
        local a1 = CS[o1] + (CS[o1 + 1] - CS[o1]) * t
        local a2 = CS[o2] + (CS[o2 + 1] - CS[o2]) * t
        L = a1 + (a2 - a1) * f
    end

    if satScale ~= 1 then A = A * satScale; B = B * satScale end
    if tVal ~= 0 then B = B + tVal * SHIFT end
    if nVal ~= 0 then A = A + nVal * SHIFT end
    if L < 0 then L = 0 elseif L > 100 then L = 100 end

    local fy2 = (L + 16) / 116
    local fx2 = fy2 + A / 500
    local fz2 = fy2 - B / 200
    local X2 = (fx2 > 0.2069 and fx2 * fx2 * fx2 or (116 * fx2 - 16) / 903.3) * 0.95047
    local Y2 = fy2 > 0.2069 and fy2 * fy2 * fy2 or (116 * fy2 - 16) / 903.3
    local Z2 = (fz2 > 0.2069 and fz2 * fz2 * fz2 or (116 * fz2 - 16) / 903.3) * 1.08883

    local ar = 3.2404542 * X2 - 1.5371385 * Y2 - 0.4985314 * Z2
    local ag = -0.9692660 * X2 + 1.8760108 * Y2 + 0.0415560 * Z2
    local ab = 0.0556434 * X2 - 0.2040259 * Y2 + 1.0572252 * Z2
    if ar <= 0 then ar = 0 elseif ar >= 1 then ar = 1 else
        local pp = ar * LUTN; local ii = math.floor(pp)
        if ii >= LUTN then ii = LUTN - 1 end
        ar = ENC[ii + 1] + (ENC[ii + 2] - ENC[ii + 1]) * (pp - ii)
    end
    if ag <= 0 then ag = 0 elseif ag >= 1 then ag = 1 else
        local pp = ag * LUTN; local ii = math.floor(pp)
        if ii >= LUTN then ii = LUTN - 1 end
        ag = ENC[ii + 1] + (ENC[ii + 2] - ENC[ii + 1]) * (pp - ii)
    end
    if ab <= 0 then ab = 0 elseif ab >= 1 then ab = 1 else
        local pp = ab * LUTN; local ii = math.floor(pp)
        if ii >= LUTN then ii = LUTN - 1 end
        ab = ENC[ii + 1] + (ENC[ii + 2] - ENC[ii + 1]) * (pp - ii)
    end

    p.R, p.G, p.B = (ar + (r - cr)) * factor, (ag + (g - cg)) * factor, (ab + (b - cb)) * factor
    return p
end

function Process(req)
    local src = InImage:GetValue(req)
    if not src then return end
    local exposure = math.max(-100, math.min(100, InExposure:GetValue(req).Value)) / 100
    local contrast = math.max(-100, math.min(100, InContrast:GetValue(req).Value)) / 100
    local saturation = math.max(-100, math.min(100, InSaturation:GetValue(req).Value)) / 100
    local temperature = math.max(-100, math.min(100, InTemperature:GetValue(req).Value)) / 100
    local tint = math.max(-100, math.min(100, InTint:GetValue(req).Value)) / 100
    local highlights = math.max(-100, math.min(100, InHighlights:GetValue(req).Value)) / 100
    local shadows = math.max(-100, math.min(100, InShadows:GetValue(req).Value)) / 100

    if InPreview:GetValue(req).Value < 0.5 then OutImage:Set(req, src); return end
    if exposure == 0 and contrast == 0 and saturation == 0 and temperature == 0
        and tint == 0 and highlights == 0 and shadows == 0 then
        OutImage:Set(req, src); return
    end

    src:DownloadGPUMem(req)
    local dst = Image({IMG_Like = src})
    dst:MultiProcessPixels(nil, {
        CE = CURVE_EXPOSURE, CK = CURVE_CONTRAST, CH = CURVE_HIGHLIGHTS, CS = CURVE_SHADOWS,
        eVal = exposure, kVal = contrast, hVal = highlights, sVal = shadows,
        satScale = 1 + saturation, tVal = temperature, nVal = tint, SHIFT = 29.3,
        PV = PVALS, PV1 = PVALS[1], PV13 = PVALS[13],
        LUTN = LUT_SIZE, DEC = DECODE, ENC = ENCODE, CL = CLIFT,
        unpremultiply = InAlpha:GetValue(req).Value > 0.5,
    }, 0, 0, src.Width, src.Height, src, processPixel)
    OutImage:Set(req, dst)
end
