-- PSN_PhotoFilter 1.1
-- Independently implemented from XYZ filtering and SetLum equations, with
-- calibration research by Seth A. Robinson (Patchy). MIT notice below.
-- https://github.com/SethRobinson/Patchy/blob/main/docs/adjustment-kinds.md
FuRegisterClass("PSN_PhotoFilter",CT_Tool,{
    REGS_Name="PSN_PhotoFilter",REGS_Category="PSN\\Color",REGS_OpIconString="PhF",
    REGS_OpDescription="Photoshop-style Photo Filter with Density and Preserve Luminosity",
    REG_NoMotionBlurCtrls=true,
})
-- sRGB swatches. Warming default sampled from Photoshop 27.2;
-- other presets are convenient RGB approximations, not exported Adobe presets.
local presets={
    {"Warming Filter (85)",237,138,0}, {"Cooling Filter (80)",0,109,255},
    {"Sepia",172,122,51}, {"Red",255,0,0}, {"Orange",255,128,0},
    {"Yellow",255,255,0}, {"Green",0,255,0}, {"Cyan",0,255,255},
    {"Blue",0,0,255}, {"Violet",128,0,255}, {"Magenta",255,0,255},
}
function Create()
    syncing=false
    controlsReady=false
    InImage=self:AddInput("Input","Input",{LINKID_DataType="Image",LINK_Main=1,INP_AcceptsDoD=false})
    OutImage=self:AddOutput("Output","Output",{LINKID_DataType="Image",LINK_Main=1})
    -- Retain the old input invisibly so v1.0 compositions can be migrated.
    InMode=self:AddInput("Legacy color mode","UseColor",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=0,IC_Visible=false,
    })
    local menu={LINKID_DataType="Number",INPID_InputControl="ComboControl",INP_Default=0,INP_Integer=true,
        INP_DoNotifyChanged=true,INP_InitialNotify=false}
    for _,p in ipairs(presets) do table.insert(menu,{CCS_AddString=p[1]}) end
    table.insert(menu,{CCS_AddString="Custom"})
    InFilter=self:AddInput("Filter","Filter",menu)
    Custom={}
    for i,name in ipairs({"Red","Green","Blue"}) do
        Custom[i]=self:AddInput(name,"Color"..name,{
            LINKID_DataType="Number",INPID_InputControl="ColorControl",ICS_Name="Color",
            IC_ControlGroup=1,IC_ControlID=i-1,CLRC_ShowWheel=false,IC_Visible=true,
            INP_DoNotifyChanged=true,INP_InitialNotify=false,
            INP_Default=presets[1][i+1]/255,INP_MinScale=0,INP_MaxScale=1,INP_MinAllowed=0,INP_MaxAllowed=1,
        })
    end
    InDensity=self:AddInput("Density (%)","Density",{
        LINKID_DataType="Number",INPID_InputControl="SliderControl",INP_Default=25,
        INP_MinScale=0,INP_MaxScale=100,INP_MinAllowed=0,INP_MaxAllowed=100,
    })
    InPreserve=self:AddInput("Preserve Luminosity","PreserveLuminosity",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    InPreview=self:AddInput("Preview","Preview",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
    })
    self:BeginControlNest("Fusion Options","FusionOptions",false,{})
    InSpace=self:AddInput("Input encoding","InputEncoding",{
        LINKID_DataType="Number",INPID_InputControl="ComboControl",INP_Default=0,
        {CCS_AddString="sRGB (Photoshop-style)"},{CCS_AddString="Linear sRGB / Rec.709 primaries"},
    })
    InQuantize=self:AddInput("Match Photoshop 8-bit steps","Match8Bit",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
        INPS_StatusText="Emulate Photoshop's intermediate byte rounding. Disable for continuous float processing.",
    })
    InAlpha=self:AddInput("Pre-Divide / Post-Multiply","PreDivide",{
        LINKID_DataType="Number",INPID_InputControl="CheckboxControl",INP_Default=1,
        INPS_StatusText="On for premultiplied RGB, off for straight RGB. Alpha is preserved.",
    })
    self:EndControlNest()
end
local function updateSwatch(index,time)
    local preset=presets[index+1]
    if preset then
        for i=1,3 do Custom[i]:SetSource(Number(preset[i+1]/255),time) end
    end
end
function OnAddToFlow()
    syncing=true
    local time=0
    if InMode:GetSource(time).Value>.5 then
        InFilter:SetSource(Number(#presets),time)
        InMode:SetSource(Number(0),time)
    else
        updateSwatch(math.floor(InFilter:GetSource(time).Value+.5),time)
    end
    syncing=false
    controlsReady=true
end
function NotifyChanged(inp,param,time)
    if syncing or not controlsReady then return end
    syncing=true
    if inp==InFilter then
        updateSwatch(math.floor(param.Value+.5),time)
    elseif inp==Custom[1] or inp==Custom[2] or inp==Custom[3] then
        InFilter:SetSource(Number(#presets),time)
    end
    syncing=false
end
local pixel=function(x,y,p)
    if p.A<=0 then return p end
    local scale=premultiplied and p.A or 1
    local original={p.R/scale,p.G/scale,p.B/scale}
    local rgb={}
    for i=1,3 do
        local v=original[i]
        if linear then v=v<=.0031308 and v*12.92 or 1.055*v^(1/2.4)-.055 end
        rgb[i]=math.max(0,math.min(1,v))
    end
    local lin={}
    for i=1,3 do local v=rgb[i];lin[i]=v<=.04045 and v/12.92 or ((v+.055)/1.055)^2.4 end
    local out={}
    for i=1,3 do
        local v=matrix[3*i-2]*lin[1]+matrix[3*i-1]*lin[2]+matrix[3*i]*lin[3]
        v=v<=.0031308 and v*12.92 or 1.055*v^(1/2.4)-.055
        v=math.max(0,math.min(1,v)); if quantize then v=math.floor(v*255+.5)/255 end
        out[i]=v
    end
    if preserve then
        local target=.30*rgb[1]+.59*rgb[2]+.11*rgb[3]
        local lum=.30*out[1]+.59*out[2]+.11*out[3]
        if quantize then target=math.floor(target*255+.5)/255;lum=math.floor(lum*255+.5)/255 end
        for i=1,3 do out[i]=out[i]+target-lum end
        local center=.30*out[1]+.59*out[2]+.11*out[3]
        local low,high=math.min(out[1],out[2],out[3]),math.max(out[1],out[2],out[3])
        if low<0 then for i=1,3 do out[i]=center+(out[i]-center)*center/math.max(1e-12,center-low) end end
        if high>1 then for i=1,3 do out[i]=center+(out[i]-center)*(1-center)/math.max(1e-12,high-center) end end
    end
    for i=1,3 do
        local v=math.max(0,math.min(1,out[i]))
        if linear then v=v<=.04045 and v/12.92 or ((v+.055)/1.055)^2.4 end
        -- Retain out-of-range residuals as a compositor-specific extension.
        out[i]=(v+original[i]-math.max(0,math.min(1,original[i])))*scale
    end
    p.R,p.G,p.B=out[1],out[2],out[3];return p
end
local M={{.4360747,.3850649,.1430804},{.2225045,.7168786,.0606169},{.0139322,.0971045,.7141733}}
local INV={{3.1338563678,-1.6168667703,-.4906147728},{-.9787685631,1.9161415526,.0334541163},{.0719451683,-.2289912773,1.4052426742}}
function Process(req)
    local src=InImage:GetValue(req);if not src then return end
    local d=math.max(0,math.min(1,InDensity:GetValue(req).Value/100))
    if d==0 or InPreview:GetValue(req).Value<.5 then OutImage:Set(req,src);return end
    local selected=math.floor(InFilter:GetValue(req).Value+.5)
    local index=math.max(1,math.min(#presets,selected+1))
    local color={}
    for i=1,3 do
        local v=(selected==#presets or InMode:GetValue(req).Value>.5) and Custom[i]:GetValue(req).Value or presets[index][i+1]/255
        v=math.max(0,math.min(1,v));color[i]=v<=.04045 and v/12.92 or ((v+.055)/1.055)^2.4
    end
    local white={.96422,1,.82521};local gain={}
    for i=1,3 do gain[i]=1-d+d*(M[i][1]*color[1]+M[i][2]*color[2]+M[i][3]*color[3])/white[i] end
    local matrix={}
    for i=1,3 do for j=1,3 do
        matrix[#matrix+1]=INV[i][1]*gain[1]*M[1][j]+INV[i][2]*gain[2]*M[2][j]+INV[i][3]*gain[3]*M[3][j]
    end end
    src:DownloadGPUMem(req)
    local dst=Image({IMG_Like=src,IMG_Depth=8})
    dst:MultiProcessPixels(nil,{matrix=matrix,preserve=InPreserve:GetValue(req).Value>.5,
        premultiplied=InAlpha:GetValue(req).Value>.5,linear=InSpace:GetValue(req).Value>.5,
        quantize=InQuantize:GetValue(req).Value>.5},0,0,src.Width,src.Height,src,pixel)
    OutImage:Set(req,dst)
end

