-- PSN_SplineArrange 1.1
-- Particle-emitter-style generator: arranges copies of a Sample image along a Shape.
-- Shape can be a Fusion mask/image (Polygon, Ellipse, Mask, etc.).
-- The shape outline is traced and used as the arrangement path.
FuRegisterClass("PSN_SplineArrange", CT_Tool, {
    REGS_Name = "PSN_SplineArrange",
    REGS_Category = "PSN\\Generator",
    REGS_OpIconString = "SAr",
    REGS_OpDescription = "Arrange copies of a sample image along a shape",
    REG_NoMotionBlurCtrls = true,
    REG_NoPreCalcProcess = true,
    REG_Fuse_NoEdit = false,
    REG_Fuse_NoReload = false,
})

function Create()
    -- 1. Shape: any mask/image shape (Polygon, Ellipse, Mask, etc.).
    InShape = self:AddInput("Shape", "Shape", {
        LINKID_DataType = "Image", LINK_Main = 1, INP_AcceptsDoD = false, INP_Required = false,
        INPS_StatusText = "Connect a Polygon, Ellipse, mask, or any image. White/alpha defines the shape outline.",
    })

    -- 2. Sample: the RGBA image that is copied along the shape.
    InSample = self:AddInput("Sample", "Sample", {
        LINKID_DataType = "Image", LINK_Main = 2, INP_AcceptsDoD = false,
        INPS_StatusText = "Image copied along the shape. The output uses this image's frame size.",
    })

    -- 3. Optional Polyline path. Open or closed; when it has 2+ points it
    -- overrides the Shape mask.
    InPath = self:AddInput("Path (optional)", "Path", {
        LINKID_DataType = "Polyline",
        INPID_InputControl = "LabelControl",
        INPID_PreviewControl = "PolylineControl",
        PLC_DrawMode = 0,
        PC_Visible = true,
        IC_Visible = true,
        INP_DoNotifyChanged = true,
        INP_Required = false,
        INPS_StatusText = "Optional open or closed Polyline drawn in the Inspector. When drawn it overrides Shape.",
    })

    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image", LINK_Main = 1,
    })

    -- 4. Density
    InDensity = self:AddInput("Density", "Density", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 100, INP_Integer = true,
        INP_MinScale = 0, INP_MaxScale = 1000,
        INP_MinAllowed = 0, INP_MaxAllowed = 1000,
        INPS_StatusText = "Number of copies distributed along the shape outline.",
    })

    -- 5. Color (grouped RGBA color control, RGB multiplier / Alpha opacity)
    InColorR = self:AddInput("Color", "ColorR", {
        LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        IC_ControlGroup = 1, IC_ControlID = 0,
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        ICS_Name = "Color",
        INPS_StatusText = "General color. RGB multiplies the copies; Alpha fades them (opacity).",
    })
    InColorG = self:AddInput("", "ColorG", {
        LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        IC_ControlGroup = 1, IC_ControlID = 1,
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
    })
    InColorB = self:AddInput("", "ColorB", {
        LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        IC_ControlGroup = 1, IC_ControlID = 2,
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
    })
    InColorA = self:AddInput("", "ColorA", {
        LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
        IC_ControlGroup = 1, IC_ControlID = 3,
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
    })

    -- 6. Random Color
    InRandomColor = self:AddInput("Random Color", "RandomColor", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Randomizes the hue of each copy. 0 = every copy keeps the general color; 1 = fully random hue.",
    })

    -- 7. Size
    InSize = self:AddInput("Size", "Size", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 4,
        INP_MinAllowed = 0, INP_MaxAllowed = 100,
        INPS_StatusText = "General size of each copy, relative to the Sample image.",
    })

    -- 8. Random Size
    InRandomSize = self:AddInput("Random Size", "RandomSize", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Random size variation per copy. 0 = uniform size; 1 = up to +/-100% variation.",
    })

    -- 8b. Random Position
    InRandomPosition = self:AddInput("Random Position", "RandomPosition", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Random sideways offset from the path, left or right along its normal. 0 = on the path; 1 = up to 20% of frame width.",
    })

    -- 9. Along Size profile: five editable points along the path.
    self:BeginControlNest("Along Size", "AlongSizeNest", true, {})
    InSizeStart = self:AddInput("Size at Start", "SizeStart", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Size multiplier at the start of the shape/path.",
    })
    InSize25 = self:AddInput("Size at 25%", "Size25", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Size multiplier a quarter of the way along.",
    })
    InSize50 = self:AddInput("Size at 50%", "Size50", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Size multiplier halfway along.",
    })
    InSize75 = self:AddInput("Size at 75%", "Size75", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Size multiplier three quarters of the way along.",
    })
    InSizeEnd = self:AddInput("Size at End", "SizeEnd", {
        LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
        INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Size multiplier at the end of the shape/path.",
    })
    self:EndControlNest()

    -- 9b. Aligned
    InAligned = self:AddInput("Aligned", "Aligned", {
        LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl",
        INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1,
        INP_MinAllowed = 0, INP_MaxAllowed = 1,
        INPS_StatusText = "Rotate each copy to follow the path tangent (banking).",
    })

    -- 10. Blending
    InBlend = self:AddInput("Blending", "Blending", {
        LINKID_DataType = "FuID", INPID_InputControl = "ComboIDControl",
        INPID_DefaultID = "Normal",
        { CCS_AddString = "Normal", CCID_AddID = "Normal" },
        { CCS_AddString = "Additive", CCID_AddID = "LinearDodge" },
        { CCS_AddString = "Multiply", CCID_AddID = "Multiply" },
        INPS_StatusText = "How the copies composite over each other.",
    })
    -- Hidden operator for the internal Merge calls (always Over).
    InMergeOp = self:AddInput("", "MergeOp", {
        LINKID_DataType = "FuID", INPID_InputControl = "ComboIDControl",
        INPID_DefaultID = "Over", IC_Visible = false,
        { CCS_AddString = "Over", CCID_AddID = "Over" },
    })
end

-- Arc-length helpers
-- ---------------------------------------------------------------------------
local function buildArc(points, closed)
    local n = #points
    if n < 2 then return nil end
    local pts = {}
    for i = 1, n do
        pts[i] = { x = points[i].x, y = points[i].y }
    end
    if closed then
        pts[n + 1] = { x = pts[1].x, y = pts[1].y }
        n = n + 1
    end
    local cum = { 0 }
    local total = 0
    for i = 2, n do
        local dx = pts[i].x - pts[i - 1].x
        local dy = pts[i].y - pts[i - 1].y
        total = total + math.sqrt(dx * dx + dy * dy)
        cum[i] = total
    end
    if total <= 1e-9 then return nil end
    return { pts = pts, cum = cum, total = total, closed = closed, count = n }
end

local function arcPoint(arc, u)
    if not arc then return nil, nil end
    local t
    if arc.closed then
        t = u - math.floor(u)
    else
        t = math.max(0, math.min(1, u))
    end
    local target = t * arc.total
    local lo, hi = 1, arc.count
    while lo < hi - 1 do
        local mid = math.floor((lo + hi) / 2)
        if arc.cum[mid] <= target then lo = mid else hi = mid end
    end
    local a = arc.pts[lo]
    local b = arc.pts[hi]
    local seg = arc.cum[hi] - arc.cum[lo]
    local f = seg > 1e-12 and (target - arc.cum[lo]) / seg or 0
    return a.x + (b.x - a.x) * f, a.y + (b.y - a.y) * f
end

local function arcTangent(arc, u)
    if not arc then return 1, 0 end
    local du = 0.001
    local u1, u2
    if arc.closed then
        u1, u2 = u - du, u + du
    else
        u1 = math.max(0, u - du)
        u2 = math.min(1, u + du)
    end
    local x1, y1 = arcPoint(arc, u1)
    local x2, y2 = arcPoint(arc, u2)
    if not x1 or not x2 then return 1, 0 end
    local tx, ty = x2 - x1, y2 - y1
    local len = math.sqrt(tx * tx + ty * ty)
    if len < 1e-9 then return 1, 0 end
    return tx / len, ty / len
end

local function buildPolylineArc(path)
    if not path then return nil end
    local ok, count = pcall(function() return path:GetCount() end)
    if not ok or type(count) ~= "number" or count < 2 then return nil end
    pcall(function() path:CalcLength() end)
    local closed = false
    pcall(function() closed = path:IsClosed() and true or false end)
    local N = math.max(64, count * 16)
    local pts = {}
    local last = closed and (N - 1) or N
    for i = 0, last do
        local u = i / N
        local okp, p = pcall(function() return path:GetPointOnPath(u) end)
        if okp and p and type(p.X) == "number" and type(p.Y) == "number" then
            pts[#pts + 1] = { x = p.X - 0.5, y = p.Y - 0.5 }
        end
    end
    if #pts < 2 then return nil end
    return buildArc(pts, closed)
end

-- ---------------------------------------------------------------------------
-- Mask outline tracing
-- ---------------------------------------------------------------------------
local function traceMask(img, req)
    if not img then return nil end
    local W, H = img.Width, img.Height
    if not W or not H or W < 2 or H < 2 then return nil end

    pcall(function() img:DownloadGPUMem(req) end)

    local step = math.max(1, math.floor(math.max(W, H) / 320 + 0.5))
    local gw = math.max(2, math.floor(W / step))
    local gh = math.max(2, math.floor(H / step))

    local px = Pixel()
    local vals = {}
    local minA, maxA = 1, 0
    for j = 0, gh - 1 do
        local row = {}
        local yy = math.min(H - 1, math.floor((j + 0.5) * step))
        for i = 0, gw - 1 do
            local xx = math.min(W - 1, math.floor((i + 0.5) * step))
            img:GetPixel(xx, yy, px)
            local a = px.A
            local l = 0.3 * px.R + 0.59 * px.G + 0.11 * px.B
            if a < minA then minA = a end
            if a > maxA then maxA = a end
            row[i] = { a = a, l = l }
        end
        vals[j] = row
    end

    local useAlpha = (maxA - minA) > 0.1
    local solid = {}
    local count = 0    for j = 0, gh - 1 do
        solid[j] = {}
        for i = 0, gw - 1 do
            local v = vals[j][i]
            local s = useAlpha and v.a or v.l
            local b = s > 0.5
            solid[j][i] = b
            if b then count = count + 1 end
        end
    end
    if count == 0 then return nil end

    -- Invert when the mask covers the frame border (black shape on white matte).
    local border, borderSolid = 0, 0
    for i = 0, gw - 1 do
        border = border + 2
        if solid[0][i] then borderSolid = borderSolid + 1 end
        if solid[gh - 1][i] then borderSolid = borderSolid + 1 end
    end
    for j = 1, gh - 2 do
        border = border + 2
        if solid[j][0] then borderSolid = borderSolid + 1 end
        if solid[j][gw - 1] then borderSolid = borderSolid + 1 end
    end
    if border > 0 and borderSolid / border > 0.5 then
        count = 0
        for j = 0, gh - 1 do
            for i = 0, gw - 1 do
                solid[j][i] = not solid[j][i]
                if solid[j][i] then count = count + 1 end
            end
        end
        if count == 0 then return nil end
    end

    -- Boundary edges around the union of solid cells (grid-corner units).
    local edges = {}
    local startMap = {}
    local function key(x, y) return x .. "," .. y end
    local function addEdge(x1, y1, x2, y2)
        local e = { x1 = x1, y1 = y1, x2 = x2, y2 = y2 }
        edges[#edges + 1] = e
        e.index = #edges
        local k = key(x1, y1)
        local list = startMap[k]
        if not list then list = {}; startMap[k] = list end
        list[#list + 1] = e
    end

    for j = 0, gh - 1 do
        for i = 0, gw - 1 do
            if solid[j][i] then
                if j == 0 or not solid[j - 1][i] then addEdge(i, j, i + 1, j) end
                if j == gh - 1 or not solid[j + 1][i] then addEdge(i + 1, j + 1, i, j + 1) end
                if i == 0 or not solid[j][i - 1] then addEdge(i, j + 1, i, j) end
                if i == gw - 1 or not solid[j][i + 1] then addEdge(i + 1, j, i + 1, j + 1) end
            end
        end
    end

    local used = {}
    local loops = {}
    for idx = 1, #edges do
        if not used[idx] then
            local startEdge = edges[idx]
            local sx, sy = startEdge.x1, startEdge.y1
            local loop = {}
            local cur = idx
            local guard = 0
            local closedLoop = false
            while cur and not used[cur] and guard <= #edges do
                used[cur] = true
                local ce = edges[cur]
                loop[#loop + 1] = { x = ce.x1 * step, y = ce.y1 * step }
                local list = startMap[key(ce.x2, ce.y2)]
                local nxt = nil
                if list then
                    for _, cand in ipairs(list) do
                        if not used[cand.index] then nxt = cand.index; break end
                    end
                end
                if ce.x2 == sx and ce.y2 == sy then
                    closedLoop = true
                    cur = nil
                else
                    cur = nxt
                end
                guard = guard + 1
            end
            if #loop >= 3 and closedLoop then
                loops[#loops + 1] = loop
            end
        end
    end
    if #loops == 0 then return nil end

    local best, bestArea = nil, 0
    for _, loop in ipairs(loops) do
        local area = 0
        for i = 1, #loop do
            local a = loop[i]
            local b = loop[(i % #loop) + 1]
            area = area + a.x * b.y - b.x * a.y
        end
        area = math.abs(area) * 0.5
        if area > bestArea then
            bestArea = area
            best = loop
        end
    end
    if not best or bestArea <= 0 then return nil end

    -- Smooth the staircase contour and reduce the number of points.
    local pts = best
    for _ = 1, 2 do
        local n = #pts
        local out = {}
        for i = 1, n do
            local a = pts[((i - 2) % n) + 1]
            local b = pts[i]
            local c = pts[(i % n) + 1]
            out[i] = { x = (a.x + b.x + c.x) / 3, y = (a.y + b.y + c.y) / 3 }
        end
        pts = out
    end

    local stride = math.max(1, math.floor(#pts / 300))
    local simp = {}
    for i = 1, #pts, stride do
        simp[#simp + 1] = { x = pts[i].x / W - 0.5, y = pts[i].y / H - 0.5 }
    end
    if #simp < 3 then return nil end
    return buildArc(simp, true)
end

-- Trace a thin open stroke (an open spline rendered as a mask) along its
-- centreline. Closed/filled masks fall through to traceMask.
local function traceStroke(img, req)
    if not img then return nil end
    local W, H = img.Width, img.Height
    if not W or not H or W < 2 or H < 2 then return nil end
    pcall(function() img:DownloadGPUMem(req) end)

    local step = math.max(1, math.floor(math.max(W, H) / 1920 + 0.5))
    local gw = math.max(2, math.floor(W / step))
    local gh = math.max(2, math.floor(H / step))
    local px = Pixel()

    -- Decide whether the mask carries shape in alpha or luminance.
    local useAlpha = false
    for j = 0, 4 do
        for i = 0, 4 do
            local xx = math.min(W - 1, math.floor((i + 0.5) * W / 5))
            local yy = math.min(H - 1, math.floor((j + 0.5) * H / 5))
            img:GetPixel(xx, yy, px)
            if px.A < 0.99 then useAlpha = true end
        end
    end

    local solid = {}
    local cells = {}
    local count = 0
    for j = 0, gh - 1 do
        solid[j] = {}
        local yy = math.min(H - 1, math.floor((j + 0.5) * step))
        for i = 0, gw - 1 do
            local xx = math.min(W - 1, math.floor((i + 0.5) * step))
            img:GetPixel(xx, yy, px)
            local s = useAlpha and px.A or (0.3 * px.R + 0.59 * px.G + 0.11 * px.B)
            if s > 0.5 then
                solid[j][i] = true
                cells[#cells + 1] = { i = i, j = j }
                count = count + 1
            end
        end
    end
    if count < 8 or count > 30000 then return nil end
    local originalCount = count

    local minI, maxI, minJ, maxJ = 1e9, -1e9, 1e9, -1e9
    for _, c in ipairs(cells) do
        if c.i < minI then minI = c.i end
        if c.i > maxI then maxI = c.i end
        if c.j < minJ then minJ = c.j end
        if c.j > maxJ then maxJ = c.j end
    end
    local bw = math.max(1, maxI - minI + 1)
    local bh = math.max(1, maxJ - minJ + 1)
    -- Filled blobs fill much of their bounding box; strokes do not.
    if originalCount > bw * bh * 0.25 then return nil end

    -- Thin the stroke to a one-cell skeleton (Zhang-Suen), so wide strokes
    -- also produce a clean open centreline instead of a contour.
    local changed = true
    while changed do
        changed = false
        for pass = 1, 2 do
            local remove = {}
            for j = 0, gh - 1 do
                for i = 0, gw - 1 do
                    if solid[j][i] then
                        local function g(y, x)
                            local row = solid[y]
                            return row and row[x] or false
                        end
                        local p2, p3, p4 = g(j - 1, i), g(j - 1, i + 1), g(j, i + 1)
                        local p5, p6, p7 = g(j + 1, i + 1), g(j + 1, i), g(j + 1, i - 1)
                        local p8, p9 = g(j, i - 1), g(j - 1, i - 1)
                        local b = (p2 and 1 or 0) + (p3 and 1 or 0) + (p4 and 1 or 0) + (p5 and 1 or 0)
                            + (p6 and 1 or 0) + (p7 and 1 or 0) + (p8 and 1 or 0) + (p9 and 1 or 0)
                        local seq = { p2, p3, p4, p5, p6, p7, p8, p9, p2 }
                        local a = 0
                        for q = 1, 8 do
                            if not seq[q] and seq[q + 1] then a = a + 1 end
                        end
                        local c1, c2
                        if pass == 1 then
                            c1 = not (p2 and p4 and p6)
                            c2 = not (p4 and p6 and p8)
                        else
                            c1 = not (p2 and p4 and p8)
                            c2 = not (p2 and p6 and p8)
                        end
                        if b >= 2 and b <= 6 and a == 1 and c1 and c2 then
                            remove[#remove + 1] = { i = i, j = j }
                        end
                    end
                end
            end
            for _, p in ipairs(remove) do
                solid[p.j][p.i] = false
                changed = true
            end
        end
    end

    cells = {}
    count = 0
    for j = 0, gh - 1 do
        for i = 0, gw - 1 do
            if solid[j][i] then
                cells[#cells + 1] = { i = i, j = j }
                count = count + 1
            end
        end
    end
    if count < 8 then return nil end

    local function key(i, j) return i * 100000 + j end

    local endpoints = {}
    for _, c in ipairs(cells) do
        local deg = 0
        for dj = -1, 1 do
            for di = -1, 1 do
                if not (di == 0 and dj == 0) then
                    local row = solid[c.j + dj]
                    if row and row[c.i + di] then deg = deg + 1 end
                end
            end
        end
        if deg <= 1 then endpoints[#endpoints + 1] = c end
    end
    if #endpoints < 1 then return nil end

    local function bfs(from)
        local queue = { from }
        local dist = { [key(from.i, from.j)] = 0 }
        local prev = {}
        local head = 1
        local far, farDist = from, 0
        while head <= #queue do
            local c = queue[head]
            head = head + 1
            local d = dist[key(c.i, c.j)]
            if d > farDist then far = c; farDist = d end
            for dj = -1, 1 do
                for di = -1, 1 do
                    if not (di == 0 and dj == 0) then
                        local ni, nj = c.i + di, c.j + dj
                        local row = solid[nj]
                        if row and row[ni] and dist[key(ni, nj)] == nil then
                            dist[key(ni, nj)] = d + 1
                            prev[key(ni, nj)] = c
                            queue[#queue + 1] = { i = ni, j = nj }
                        end
                    end
                end
            end
        end
        return far, farDist, prev
    end

    -- Double BFS gives the longest path even when a 1 px stroke has small
    -- antialiasing spurs and many apparent endpoints.
    local aEnd = bfs(endpoints[1])
    local far, farDist, prev = bfs(aEnd)
    if farDist < 8 then return nil end

    local path = {}
    local c = far
    while c do
        path[#path + 1] = c
        c = prev[key(c.i, c.j)]
    end
    for i = 1, math.floor(#path / 2) do
        path[i], path[#path - i + 1] = path[#path - i + 1], path[i]
    end
    if #path < 8 then return nil end
    -- A filled blob with accidental endpoints is much wider than its path.
    if originalCount > #path * 5 then return nil end

    local pts = {}
    for _, p in ipairs(path) do
        pts[#pts + 1] = { x = (p.i + 0.5) * step, y = (p.j + 0.5) * step }
    end
    for _ = 1, 2 do
        local n = #pts
        local out = {}
        for i = 1, n do
            local a = pts[math.max(1, i - 1)]
            local b = pts[i]
            local c2 = pts[math.min(n, i + 1)]
            out[i] = { x = (a.x + b.x + c2.x) / 3, y = (a.y + b.y + c2.y) / 3 }
        end
        pts = out
    end
    local stride = math.max(1, math.floor(#pts / 300))
    local simp = {}
    for i = 1, #pts, stride do
        simp[#simp + 1] = { x = pts[i].x / W - 0.5, y = pts[i].y / H - 0.5 }
    end
    if #simp < 3 then return nil end
    return buildArc(simp, false)
end

-- ---------------------------------------------------------------------------
-- Output helpers
-- ---------------------------------------------------------------------------
local rngState = 1
local function rngSeed(s)
    rngState = (math.floor(s) % 2147483646) + 1
end

local function rnd()
    rngState = (rngState * 1103515245 + 12345) % 2147483648
    return rngState / 2147483648
end

local function hsvToRgb(h, s, v)
    local i = math.floor(h * 6)
    local f = h * 6 - i
    local p = v * (1 - s)
    local q = v * (1 - f * s)
    local t = v * (1 - (1 - f) * s)
    i = i % 6
    if i == 0 then return v, t, p
    elseif i == 1 then return q, v, p
    elseif i == 2 then return p, v, t
    elseif i == 3 then return p, q, v
    elseif i == 4 then return t, p, v
    else return v, p, q end
end

-- Fast coarse check: filled/closed masks go straight to traceMask, while thin
-- strokes need the more expensive skeleton tracer.
local function maskIsThin(img, req)
    if not img then return false end
    local W, H = img.Width, img.Height
    if not W or not H then return false end
    pcall(function() img:DownloadGPUMem(req) end)
    local px = Pixel()
    local useAlpha = false
    for j = 0, 4 do
        for i = 0, 4 do
            local xx = math.min(W - 1, math.floor((i + 0.5) * W / 5))
            local yy = math.min(H - 1, math.floor((j + 0.5) * H / 5))
            img:GetPixel(xx, yy, px)
            if px.A < 0.99 then useAlpha = true end
        end
    end
    local step = math.max(2, math.floor(math.max(W, H) / 256 + 0.5))
    local gw, gh = math.floor(W / step), math.floor(H / step)
    if gw < 2 or gh < 2 then return true end
    local count, x0, y0, x1, y1 = 0, W - 1, H - 1, 0, 0
    for j = 0, gh - 1 do
        local yy = math.min(H - 1, math.floor((j + 0.5) * step))
        for i = 0, gw - 1 do
            local xx = math.min(W - 1, math.floor((i + 0.5) * step))
            img:GetPixel(xx, yy, px)
            local s = useAlpha and px.A or (0.3 * px.R + 0.59 * px.G + 0.11 * px.B)
            if s > 0.5 then
                count = count + 1
                if xx < x0 then x0 = xx end
                if xx > x1 then x1 = xx end
                if yy < y0 then y0 = yy end
                if yy > y1 then y1 = yy end
            end
        end
    end
    if count == 0 then return true end
    local bw, bh = x1 - x0 + 1, y1 - y0 + 1
    return count / (bw * bh) < 0.2
end

local function blankOutput(req, sample)
    local out = Image({ IMG_Like = sample, IMG_NoData = req:IsPreCalc(), IMG_DeferAlloc = true })
    out:Fill(Pixel({ R = 0, G = 0, B = 0, A = 0 }), {
        IMGPR_GPURequested = true,
        IMGPR_SourceReq = req,
    })
    OutImage:Set(req, out)
end

function Process(req)
    local sample = InSample:GetValue(req)
    if not sample then return end
    

    if req:IsPreCalc() then
        local out = Image({ IMG_Like = sample, IMG_NoData = true })
        OutImage:Set(req, out)
        return
    end

    local density = math.floor(InDensity:GetValue(req).Value + 0.5)
    if density < 0 then density = 0 end
    if density > 1000 then density = 1000 end

    local size = InSize:GetValue(req).Value
    local randomSize = math.max(0, math.min(1, InRandomSize:GetValue(req).Value))
    local randomPosition = math.max(0, math.min(1, InRandomPosition:GetValue(req).Value))
    local aligned = InAligned:GetValue(req).Value > 0.5
    local randomColor = math.max(0, math.min(1, InRandomColor:GetValue(req).Value))
    local cr = InColorR:GetValue(req).Value
    local cg = InColorG:GetValue(req).Value
    local cb = InColorB:GetValue(req).Value
    local ca = InColorA:GetValue(req).Value
    local blendValue = InBlend:GetValue(req)
    local blendID = blendValue.Value
    local blendName = blendID and tostring(blendID) or "Normal"
    local mergeOp = InMergeOp:GetValue(req).Value
    local mode = 0
    if blendName == "LinearDodge" then
        mode = 1
    elseif blendName == "Multiply" then
        mode = 2
    end

    if density < 1 or size <= 0 then
        blankOutput(req, sample)
        return
    end

    -- An optional Polyline path overrides the Shape mask. Paths may be open
    -- or closed; masks are traced as closed outlines.
    local shape = InShape:GetValue(req)
    local arc = buildPolylineArc(InPath:GetValue(req))
    if not arc then
        if maskIsThin(shape, req) then
            arc = traceStroke(shape, req)
        end
        if not arc then
            arc = traceMask(shape, req)
        end
    end

    if not arc then
        blankOutput(req, sample)
        return
    end

    local out = Image({ IMG_Like = sample, IMG_NoData = false, IMG_DeferAlloc = true })
    -- Multiply needs a white transparent backdrop so isolated copies keep their
    -- own color; Normal/Additive start from transparent black.
    local bgR, bgG, bgB = 0, 0, 0
    if mode == 2 then bgR, bgG, bgB = 1, 1, 1 end
    out:Fill(Pixel({ R = bgR, G = bgG, B = bgB, A = 0 }), {
        IMGPR_GPURequested = true,
        IMGPR_SourceReq = req,
    })

    local profile = {
        InSizeStart:GetValue(req).Value,
        InSize25:GetValue(req).Value,
        InSize50:GetValue(req).Value,
        InSize75:GetValue(req).Value,
        InSizeEnd:GetValue(req).Value,
    }
    local function profileAt(u)
        local p = math.max(0, math.min(1, u)) * 4
        local i = math.floor(p)
        local f = p - i
        if i >= 4 then return profile[5] end
        return profile[i + 1] * (1 - f) + profile[i + 2] * f
    end

    rngSeed(12345 + density * 7919)

    for k = 0, density - 1 do
        local u
        if density == 1 then
            u = 0.5
        elseif arc.closed then
            u = (k + 0.5) / density
        else
            u = k / (density - 1)
        end

        local px, py = arcPoint(arc, u)
        if px and py then
            local tx, ty = arcTangent(arc, u)
            local angle = math.atan2(ty, tx)
            -- Random Position: always consume one value so the other random
            -- choices stay stable when this slider changes.
            local side = rnd() * 2 - 1
            local offset = side * randomPosition * 0.2
            px = px - ty * offset
            py = py + tx * offset

            -- Random hue: always consume one value so size variation is stable.
            local hue = rnd()
            local rHue, gHue, bHue = hsvToRgb(hue, 1, 1)
            local tr, tg, tb = cr, cg, cb
            if randomColor > 0 then
                tr = cr * (1 + (rHue - 1) * randomColor)
                tg = cg * (1 + (gHue - 1) * randomColor)
                tb = cb * (1 + (bHue - 1) * randomColor)
            end

            local curveValue = profileAt(u)

            local s = size * curveValue
            if randomSize > 0 then
                s = s * (1 + (rnd() * 2 - 1) * randomSize)
            else
                rnd() -- keep the RNG sequence identical whether random size is on or off
            end

            if s > 0.0005 then
                local xargs = {
                    XF_XOffset = px + 0.5,
                    XF_YOffset = py + 0.5,
                    XF_XSize = s,
                    XF_YSize = s,
                    XF_Angle = aligned and (angle * 180 / math.pi) or 0,
                    XF_PivotX = 0.5,
                    XF_PivotY = 0.5,
                    XF_Filter = "Linear",
                    IMGPR_GPURequested = true,
                    IMGPR_SourceReq = req,
                }
                local copy = sample:Transform(nil, xargs)
                if copy then
                    -- Tint every copy directly. This is a true multiply and
                    -- works for Normal and for the apply-mode blends (which
                    -- ignore Merge foreground gains).
                    -- Alpha in the Color swatch acts as copy opacity.
                    local gr, gg, gb = tr * ca, tg * ca, tb * ca
                    local tinted = copy
                    local didTint = false
                    if gr ~= 1 or gg ~= 1 or gb ~= 1 or ca ~= 1 then
                        local okg, g = pcall(function()
                            return copy:GainOf(gr, gg, gb, ca, {
                                IMGPR_GPURequested = true,
                                IMGPR_SourceReq = req,
                            })
                        end)
                        if okg and g then
                            tinted = g
                            didTint = true
                        end
                    end

                    local mergeArgs = {}
                    if mode > 0 and blendID ~= nil then
                        mergeArgs.MO_ApplyMode = blendID
                    end
                    mergeArgs.MO_ApplyOperator = mergeOp
                    mergeArgs.MO_FgAddSub = 1
                    if mode == 0 and not didTint then
                        mergeArgs.MO_FgRedGain = gr
                        mergeArgs.MO_FgGreenGain = gg
                        mergeArgs.MO_FgBlueGain = gb
                        mergeArgs.MO_FgAlphaGain = ca
                    else
                        mergeArgs.MO_FgRedGain = 1
                        mergeArgs.MO_FgGreenGain = 1
                        mergeArgs.MO_FgBlueGain = 1
                        mergeArgs.MO_FgAlphaGain = 1
                    end
                    mergeArgs.IMGPR_GPURequested = true
                    mergeArgs.IMGPR_SourceReq = req
                    out:Merge(tinted, mergeArgs)
                end
            end
        end
    end

    OutImage:Set(req, out)
end
